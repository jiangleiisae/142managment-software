# Copy this file to .env (gitignored) and fill in real values before running
# `docker compose up`. See DEPLOYMENT.md for details.

# Postgres password for the tcms_app user (both the postgres container and the API use this).
DB_PASSWORD=change-me

# JWT signing secret - generate with: openssl rand -hex 48
JWT_SECRET=change-me

# Public domain name, e.g. training.feiken.group. Must already resolve (an A record) to this
# server's public IP before `docker compose up`, or Caddy's automatic Let's Encrypt HTTPS will
# fail. Leave unset (defaults to "localhost") for a plain-HTTP local/LAN deployment with no
# domain - Caddy then skips certificate issuance automatically.
DOMAIN=training.feiken.group

# Origin the browser frontend is served from. Defaults to https://$DOMAIN - only override this if
# you're not using Caddy's HTTPS front door (e.g. plain HTTP behind your own reverse proxy).
# CORS_ORIGIN=https://training.feiken.group

# File storage backend for uploaded documents (QTG/MQTG etc). "local" (default) persists to the
# api_uploads Docker volume - fine for a single instance. Set to "s3" to use an S3-compatible
# object store (AWS S3, Cloudflare R2, MinIO, Aliyun/Tencent OSS's S3-compatible mode, ...)
# instead, required before scaling to multiple API instances. See DEPLOYMENT.md.
# STORAGE_DRIVER=s3
# S3_BUCKET=your-bucket-name
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=change-me
# S3_SECRET_ACCESS_KEY=change-me
# S3_FORCE_PATH_STYLE=true

# SMS notifications. "log" (default) just logs the message instead of sending - safe for dev/test,
# no account needed. Set to "aliyun" to actually send via Aliyun SMS (阿里云短信服务); requires a
# pre-approved sign name + template in the Aliyun console. See DEPLOYMENT.md.
# SMS_PROVIDER=aliyun
# ALIYUN_ACCESS_KEY_ID=change-me
# ALIYUN_ACCESS_KEY_SECRET=change-me
# ALIYUN_SMS_SIGN_NAME=your-approved-sign-name
# ALIYUN_SMS_TEMPLATE_CODE=SMS_xxxxxxxx
# ALIYUN_SMS_TEMPLATE_PARAM_KEY=content
