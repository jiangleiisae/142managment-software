# Copy this file to .env (gitignored) and fill in real values before running
# `docker compose up`. See DEPLOYMENT.md for details.

# Postgres password for the tcms_app user (both the postgres container and the API use this).
DB_PASSWORD=change-me

# JWT signing secret - generate with: openssl rand -hex 48
JWT_SECRET=change-me

# Origin(s) the browser frontend is served from, comma-separated. Must match how you actually
# reach the web container (default below assumes the default WEB_PORT of 8080 on localhost).
CORS_ORIGIN=http://localhost:8080

# Host port the web container's nginx listens on (the API is only reachable through it).
WEB_PORT=8080
