// 培训中心管理系统 - 数据模型 (EASA主线, 对应 培训中心管理系统_需求清单.md 第一期MVP范围)
// 模块编号对应需求清单第3节: 3.1机构 / 3.2管理体系 / 3.3模拟机 / 3.5人员 / 3.6课程 / 3.7学员 / 3.8排班

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 通用: 多租户 + 审计 + 变更管理 (跨模块基础设施)
// ============================================================

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  organizations Organization[]
  users         User[]

  @@map("tenants")
}

enum UserRole {
  OWNER // 租户创建者/最高权限
  ADMIN
  STAFF
}

/// 登录账号 (认证主体), 与 Personnel (航空业务人员档案) 是可选的一对一关联而非同一实体——
/// 不是每个登录账号都对应一名受监管的航空人员(如纯IT管理员), 也不是每个Personnel都需要登录权限
model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  personnelId  String?  @unique
  createdAt    DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  personnel Personnel? @relation(fields: [personnelId], references: [id])

  @@map("users")
}

/// 通用审计轨迹, 覆盖所有需要"可追溯/防篡改"的实体变更 (ORA.GEN.220)
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  entityType String // 如 "Organization" / "Fstd" / "OrganizationCertificate"
  entityId   String
  action     String // create / update / delete / status_change
  actorId    String? // 操作人 (Personnel.id), 系统自动操作为 null
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

/// 变更管理通用状态机 (ORA.GEN.130), 供机构变更/课程变更/FSTD变更复用
enum ChangeApprovalType {
  PRIOR_APPROVAL // 需事先批准 (提前≥30天, 人员变更≥10天)
  NOTIFICATION_ONLY // 无需事先批准, 按内部程序执行后通知当局
}

enum ChangeRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  LOGGED
  NOTIFIED
}

model ChangeRequest {
  id             String              @id @default(cuid())
  tenantId       String
  entityType     String // "Organization" / "Fstd" / "Course" ...
  entityId       String
  changeType     String // 机构名称/地址/负责人变更/FSTD升级/搬迁 等具体类型
  approvalType   ChangeApprovalType
  status         ChangeRequestStatus @default(DRAFT)
  beforeJson     Json?
  afterJson      Json?
  submittedAt    DateTime?
  effectiveAt    DateTime?
  authorityReply String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([tenantId, entityType, entityId])
  @@map("change_requests")
}

/// 记录保存策略引擎配置表 (需求清单 3.9)
model RecordRetentionPolicy {
  id              String   @id @default(cuid())
  documentType    String   @unique // 如 "student_training_record" / "fstd_mqtg" / "audit_finding"
  retentionMonths Int? // null = 永久保存 (如 MQTG/初始鉴定记录)
  anchorEvent     String   @default("created_at") // 保存期起算点: "created_at" | "enrollment_completed_at"
  basisRegulation String? // 法规依据, 如 "ORA.ATO.120"
  description     String?

  @@map("record_retention_policies")
}

// ============================================================
// 3.1 机构与ATO证书管理
// ============================================================

enum OrganizationType {
  EASA_ATO
  EASA_ATO_DUAL_FAA142 // 预留: 未来若需同时服务FAA Part142客户
}

model Organization {
  id                  String           @id @default(cuid())
  tenantId            String
  type                OrganizationType @default(EASA_ATO)
  name                String
  address             String?
  competentAuthority  String? // 主管当局名称
  isComplexOrg        Boolean          @default(false) // AMC1 ORA.GEN.200(b) 复杂/非复杂机构判定
  complexOrgReason    String? // 触发复杂机构判定的具体原因 (>20FTE / FFS训练 / MP / ZFTT / 多场地 等)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  certificates         OrganizationCertificate[]
  applicationRecords   ApplicationRecord[]
  personnelAssignments PersonnelRoleAssignment[]
  fstds                Fstd[]
  courses              Course[]
  students             Student[]
  hazards              HazardRegisterEntry[]
  auditSchedules       AuditSchedule[]
  occurrenceReports    OccurrenceReport[]
  contracts            ContractRecord[]
  bookings             Booking[]
  spareParts           SparePart[]
  tools                Tool[]
  suppliers            Supplier[]
  purchaseOrders       PurchaseOrder[]
  safetyPolicies             SafetyPolicy[]
  managementOfChanges        ManagementOfChange[]
  emergencyResponsePlans     EmergencyResponsePlan[]
  safetyPerformanceIndicators SafetyPerformanceIndicator[]
  safetyReviewBoardMeetings  SafetyReviewBoardMeeting[]
  informationAssets    InformationAsset[]
  infoSecurityIncidents InfoSecurityIncident[]

  @@map("organizations")
}

enum CertificateStatus {
  ACTIVE // 持续有效 (ORA.GEN.135 Continued Validity)
  SUSPENDED
  REVOKED
  TERMINATED
}

/// 对应 EASA Form 143 模板 (ORA.ATO批准证书)
model OrganizationCertificate {
  id               String            @id @default(cuid())
  organizationId   String
  certificateNo    String
  issuedAuthority  String
  regulationBasis  String            @default("Regulation (EU) No 1178/2011")
  approvalScope    String // 批准范围声明文本
  status           CertificateStatus @default(ACTIVE)
  issuedAt         DateTime
  suspendedAt      DateTime?
  revokedAt        DateTime?
  terminatedAt     DateTime?
  statusReason     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization         Organization                     @relation(fields: [organizationId], references: [id])
  courseApprovals      TrainingCourseApprovalAttachment[]

  @@map("organization_certificates")
}

/// 证书附件: 课程批准列表, 比证书本身更新更频繁 (一对多)
model TrainingCourseApprovalAttachment {
  id             String   @id @default(cuid())
  certificateId  String
  courseId       String
  approvedFstdCodes String[] // 可用FSTD清单 (字母代码)
  approvedAt     DateTime @default(now())
  revokedAt      DateTime?

  certificate OrganizationCertificate @relation(fields: [certificateId], references: [id])
  course      Course                  @relation(fields: [courseId], references: [id])

  @@map("training_course_approval_attachments")
}

/// ORA.ATO.105 申请材料
model ApplicationRecord {
  id                    String   @id @default(cuid())
  organizationId        String
  isChangeApplication   Boolean  @default(false) // 首次申请 vs 变更申请(仅需提交变更相关部分)
  proposedStartDate     DateTime?
  headOfTrainingInfo    Json?
  trainingSitesJson     Json? // 训练场地清单
  aircraftListJson      Json? // 航空器清单: 机型/注册号/所有人/适航证类别
  fstdListJson          Json?
  courseTypesJson       Json?
  operationsManualRef   String?
  trainingManualRef     String?
  submittedAt           DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("application_records")
}

// ============================================================
// 3.2 管理体系: SMS + 合规监督(QMS)
// ============================================================

enum ManagementRoleType {
  ACCOUNTABLE_MANAGER
  NOMINATED_PERSON_COMPLIANCE
  SAFETY_MANAGER
  COMPLIANCE_MONITORING_MANAGER
  HEAD_OF_TRAINING
  CFI // 总飞行教员
  CTKI // 总理论教员
}

model PersonnelRoleAssignment {
  id             String             @id @default(cuid())
  organizationId String
  personnelId    String
  role           ManagementRoleType
  startDate      DateTime
  endDate        DateTime?
  appointmentRef String? // 任命文件编号

  organization Organization @relation(fields: [organizationId], references: [id])
  personnel    Personnel    @relation(fields: [personnelId], references: [id])

  @@map("personnel_role_assignments")
}

/// 危险源登记 (SMS核心, 二期完整实现, 一期先建表)
model HazardRegisterEntry {
  id             String   @id @default(cuid())
  organizationId String
  source         String // internal_report / audit / occurrence
  description    String
  affectedArea   String? // 涉及运行环节: 训练科目/FSTD/场地
  createdAt      DateTime @default(now())

  organization    Organization      @relation(fields: [organizationId], references: [id])
  riskAssessments RiskAssessment[]

  @@map("hazard_register_entries")
}

model RiskAssessment {
  id               String   @id @default(cuid())
  hazardId         String
  probabilityLevel Int
  severityLevel    Int
  riskScore        Int
  existingMitigation String?
  residualRiskLevel  Int?
  assessedAt       DateTime @default(now())

  hazard    HazardRegisterEntry @relation(fields: [hazardId], references: [id])
  mitigations MitigationAction[]
  changesUsingThisAssessment ManagementOfChange[]

  @@map("risk_assessments")
}

model MitigationAction {
  id               String    @id @default(cuid())
  riskAssessmentId String
  description      String
  responsiblePersonnelId String?
  dueDate          DateTime?
  status           String    @default("open") // open / in_progress / closed

  riskAssessment RiskAssessment @relation(fields: [riskAssessmentId], references: [id])

  @@map("mitigation_actions")
}

/// 安全政策 (3.2.2 SMS核心要素2): 版本化, 新版本生效时旧版本自动标记为已替代; 须由负责人(Accountable Manager)签署
model SafetyPolicy {
  id             String    @id @default(cuid())
  organizationId String
  version        String
  policyText     String
  effectiveDate  DateTime
  signedById     String? // Personnel.id, 应为负责人 Accountable Manager
  signedAt       DateTime?
  supersededAt   DateTime? // 被新版本替代的时间, null=当前生效版本
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("safety_policies")
}

/// 变更管理 MOC (3.2.2): draft -> risk_assessed -> implemented -> verified, 变更前必须完成风险评估才能实施
enum MocStatus {
  DRAFT
  RISK_ASSESSED
  IMPLEMENTED
  VERIFIED
}

model ManagementOfChange {
  id                  String    @id @default(cuid())
  organizationId      String
  changeDescription   String // 新课程/新设备/新场地等
  status              MocStatus @default(DRAFT)
  riskAssessmentId    String? // 变更前风险评估, 必须存在才能进入实施阶段
  implementationPlan  String?
  implementedAt       DateTime?
  verificationNotes   String?
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id])
  riskAssessment RiskAssessment? @relation(fields: [riskAssessmentId], references: [id])

  @@map("management_of_changes")
}

/// 应急响应计划 ERP (3.2.2): 版本化预案 + 演练记录, 标准演练周期12个月
model EmergencyResponsePlan {
  id             String    @id @default(cuid())
  organizationId String
  version        String
  planText       String
  effectiveDate  DateTime
  supersededAt   DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  drills       ErpDrill[]

  @@map("emergency_response_plans")
}

model ErpDrill {
  id          String   @id @default(cuid())
  erpId       String
  drilledAt   DateTime
  scenario    String
  outcome     String?
  nextDueDate DateTime // drilledAt + 12个月 (标准年度演练周期)
  createdAt   DateTime @default(now())

  erp EmergencyResponsePlan @relation(fields: [erpId], references: [id])

  @@map("erp_drills")
}

/// 安全绩效指标 SPI/SPT (3.2.2): 指标定义+目标值, 周期采集值判断是否达标
enum SpiDirection {
  LOWER_IS_BETTER // 如: 事件率, 数值越低越好
  HIGHER_IS_BETTER // 如: 培训完成率, 数值越高越好
}

model SafetyPerformanceIndicator {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  targetValue    Float // SPT (Safety Performance Target)
  direction      SpiDirection @default(LOWER_IS_BETTER)
  createdAt      DateTime     @default(now())

  organization Organization                   @relation(fields: [organizationId], references: [id])
  measurements SafetyPerformanceMeasurement[]

  @@map("safety_performance_indicators")
}

model SafetyPerformanceMeasurement {
  id          String   @id @default(cuid())
  indicatorId String
  periodStart DateTime
  periodEnd   DateTime
  value       Float
  createdAt   DateTime @default(now())

  indicator SafetyPerformanceIndicator @relation(fields: [indicatorId], references: [id])

  @@map("safety_performance_measurements")
}

/// 安全评审委员会会议 (3.2.2, 复杂机构): 会议+决议+行动跟踪, 复用类似缓解措施的开闭状态
model SafetyReviewBoardMeeting {
  id             String   @id @default(cuid())
  organizationId String
  meetingDate    DateTime
  attendeeRoles  String[] // ManagementRoleType 值的数组
  agenda         String
  decisions      String?
  createdAt      DateTime @default(now())

  organization Organization              @relation(fields: [organizationId], references: [id])
  actions      SafetyReviewBoardAction[]

  @@map("safety_review_board_meetings")
}

model SafetyReviewBoardAction {
  id                     String    @id @default(cuid())
  meetingId              String
  description            String
  responsiblePersonnelId String?
  dueDate                DateTime?
  status                 String    @default("open") // open / closed

  meeting SafetyReviewBoardMeeting @relation(fields: [meetingId], references: [id])

  @@map("safety_review_board_actions")
}

/// 事件报告 (ORA.GEN.160), 72小时强制上报倒计时是核心告警需求
model OccurrenceReport {
  id                String    @id @default(cuid())
  organizationId    String
  discoveredAt      DateTime // 用于计算72小时时限起点
  reportedAt        DateTime?
  occurrenceType    String
  involvedPersonnel String?
  involvedAircraft  String?
  involvedFstdId    String?
  isMandatory       Boolean   @default(true) // 强制 vs 自愿报告
  reportedTo        String? // 主管当局 / 设计批准持有人 等
  followUpStatus    String?   @default("pending")
  createdAt         DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("occurrence_reports")
}

/// 合规监督闭环: audit_schedule -> audit_task -> finding -> corrective_action -> closure
model AuditSchedule {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  scopeTag       String   @default("organization") // "organization" | "fstd" (3.2.6 FSTD专项复用同一闭环)
  plannedAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  tasks        AuditTask[]

  @@map("audit_schedules")
}

model AuditTask {
  id              String   @id @default(cuid())
  auditScheduleId String
  auditorId       String? // 必须独立于被审核职能
  scope           String
  performedAt     DateTime?
  status          String    @default("planned") // planned / in_progress / completed

  auditSchedule AuditSchedule @relation(fields: [auditScheduleId], references: [id])
  findings      Finding[]

  @@map("audit_tasks")
}

model Finding {
  id           String   @id @default(cuid())
  auditTaskId  String
  level        Int // 1 或 2, 对应 ARA.GEN.350
  description  String
  rootCause    String?
  createdAt    DateTime @default(now())

  auditTask         AuditTask          @relation(fields: [auditTaskId], references: [id])
  correctiveActions CorrectiveAction[]

  @@map("findings")
}

model CorrectiveAction {
  id                 String    @id @default(cuid())
  findingId          String
  planDescription    String
  responsiblePersonnelId String?
  dueDate            DateTime?
  status             String    @default("open") // open / verifying / closed
  closedAt           DateTime?

  finding Finding @relation(fields: [findingId], references: [id])

  @@map("corrective_actions")
}

model ContractRecord {
  id             String   @id @default(cuid())
  organizationId String
  contractorName String
  scope          String
  agreementRef   String?
  includedInAudit Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("contract_records")
}

// ============================================================
// 3.2.4 信息安全管理体系 ISMS ((EU) 2023/203, 2026-02-22起适用, 独立于Part-ORA的SMS)
// ============================================================

enum InfoAssetCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL // 直接影响飞行训练安全的资产 (如FSTD控制系统/学员资质数据库)
}

/// 信息资产清单
model InformationAsset {
  id               String               @id @default(cuid())
  organizationId   String
  name             String
  category         String // 如: 数据库/网络设备/云服务/终端设备/第三方系统
  criticality      InfoAssetCriticality @default(MEDIUM)
  ownerPersonnelId String?
  description      String?
  createdAt        DateTime             @default(now())

  organization    Organization                  @relation(fields: [organizationId], references: [id])
  riskAssessments InfoSecurityRiskAssessment[]
  incidents       InfoSecurityIncident[]

  @@map("information_assets")
}

/// 信息安全风险评估: 复用SMS风险矩阵模式 (概率x影响), 保持系统内两套风险评估体验一致
model InfoSecurityRiskAssessment {
  id                String   @id @default(cuid())
  assetId           String
  likelihoodLevel   Int // 1-5
  impactLevel       Int // 1-5
  riskScore         Int // likelihoodLevel x impactLevel
  existingControls  String?
  residualRiskLevel Int?
  assessedAt        DateTime @default(now())

  asset       InformationAsset                @relation(fields: [assetId], references: [id])
  mitigations InfoSecurityMitigationAction[]

  @@map("info_security_risk_assessments")
}

model InfoSecurityMitigationAction {
  id                     String    @id @default(cuid())
  riskAssessmentId       String
  description            String
  responsiblePersonnelId String?
  dueDate                DateTime?
  status                 String    @default("open") // open / in_progress / closed

  riskAssessment InfoSecurityRiskAssessment @relation(fields: [riskAssessmentId], references: [id])

  @@map("info_security_mitigation_actions")
}

/// 信息安全事件响应: OPEN -> CONTAINED -> RESOLVED, 参照NIST事件响应流程(遏制先于解决)
enum InfoSecurityIncidentStatus {
  OPEN
  CONTAINED
  RESOLVED
}

model InfoSecurityIncident {
  id              String                     @id @default(cuid())
  organizationId  String
  discoveredAt    DateTime
  incidentType    String // 如: 未授权访问/数据泄露/勒索软件/系统中断/钓鱼攻击
  description     String
  affectedAssetId String?
  severity        Int // 1-5
  status          InfoSecurityIncidentStatus @default(OPEN)
  responseActions String?
  containedAt     DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime                   @default(now())

  organization  Organization      @relation(fields: [organizationId], references: [id])
  affectedAsset InformationAsset? @relation(fields: [affectedAssetId], references: [id])

  @@map("info_security_incidents")
}

// ============================================================
// 3.3 模拟机资质与技术管理 (一期仅 legacy 等级字典, 不做FCS矩阵)
// ============================================================

enum FstdQualificationBasisType {
  EASA_LEGACY_LEVEL
  EASA_FCS // 二期/三期启用
}

enum FstdDeviceType {
  FFS
  FTD
  FNPT
  BITD
}

model Fstd {
  id                    String                     @id @default(cuid())
  organizationId        String
  deviceCode            String // 设备编号
  serialNumber          String?
  representedAircraft   String // 代表机型/机型组
  deviceType            FstdDeviceType
  qualificationBasisType FstdQualificationBasisType @default(EASA_LEGACY_LEVEL)
  qualificationBasisVersion String? // 初始鉴定采用的标准版本, 后续周期性鉴定持续沿用
  location              String?
  status                String                     @default("active") // active / deactivated / relocating / decommissioned
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id])
  legacyLevel     FstdLegacyLevel?
  qualifiedTasks  FstdQualifiedTask[]
  fcsCapabilities FstdFcsCapability[]
  equipmentSpecificationLists EquipmentSpecificationList[]
  recurrentEvals  FstdRecurrentEvaluation[]
  safetyFacilityChecks FstdSafetyFacilityCheck[]
  discrepancies   DiscrepancyLog[]
  changeRequests  FstdChangeRequest[]
  qtgDocuments    FstdQtgDocument[]
  qtgQuarterlyRuns FstdQtgQuarterlyRun[]

  @@unique([organizationId, deviceCode])
  @@map("fstds")
}

enum LegacyLevel {
  FFS_A
  FFS_B
  FFS_C
  FFS_D
  FTD_1
  FTD_2
  FNPT_I
  FNPT_II
  FNPT_II_MCC
  BITD
}

model FstdLegacyLevel {
  id     String      @id @default(cuid())
  fstdId String      @unique
  level  LegacyLevel

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@map("fstd_legacy_levels")
}

/// 已鉴定任务清单 (连接设备与训练), 一期用课程直接挂钩等级的方式, 训练矩阵留待FCS体系(三期)
model FstdQualifiedTask {
  id          String  @id @default(cuid())
  fstdId      String
  taskCode    String // 训练科目编号
  taskName    String
  requiresSpecialAuth Boolean @default(false)

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@map("fstd_qualified_tasks")
}

// ============================================================
// 3.3.2/3.3.3 FCS能力矩阵与训练矩阵 (CS-FSTD Issue 1, qualificationBasisType=EASA_FCS时启用, 三期)
// ============================================================

/// 14个特征 (核对 AMC/GM to Part-FCL Issue 1 Amdt 15, GM1 to Appendix 9 Section A point 1g):
/// 飞机仿真特征(7) + 感知/线索仿真特征(Cueing, 4) + 环境仿真特征(3)。
/// 注: "运动仿真"缩写在两份2026年官方新文件中不一致——AMC/GM to Part-FCL写作MNT,
/// AMC/GM to Part-ORA的ESL模板写作MTN; 本系统采用MTN(与ESL模板一致), 待官方勘误后再确认。
enum FcsCharacteristic {
  FDK // 飞行甲板布局与结构 Flight deck layout and structure
  CLH // 飞行操纵力与硬件 Flight controls forces and hardware
  CLO // 飞行操纵系统操作 Flight controls systems operation
  SYS // 飞机系统 Aircraft systems (支持子系统展开: 自动驾驶/FMS/液压等)
  GND // 地面性能与操作 Performance and handling on ground
  IGE // 地面效应内性能与操作 Performance and handling in ground effect
  OGE // 地面效应外性能与操作 Performance and handling out of ground effect
  SND // 声音仿真 Sound cueing
  VIB // 振动仿真 Vibration cueing
  MTN // 运动仿真 Motion cueing (官方缩写不一致, 见上方说明)
  VIS // 视景仿真 Visual cueing
  NAV // 导航 Navigation
  ATM // 大气与天气 Atmosphere and weather
  OST // 运行场地与地形 Operating sites and terrain
}

/// 4级保真度, 顺序 N < G < R < S
enum FcsFidelityLevel {
  N // None 无
  G // Generic 通用
  R // Representative 代表
  S // Specific 专用
}

/// FCS能力矩阵: 设备在14个特征上各自的保真度; SYS特征可按子系统(如autopilot/FMS/hydraulics)展开多条记录
model FstdFcsCapability {
  id             String            @id @default(cuid())
  fstdId         String
  characteristic FcsCharacteristic
  fidelityLevel  FcsFidelityLevel
  subsystem      String? // 仅SYS特征展开使用, 其余特征为null
  isAssigned     Boolean           @default(false) // true=主管机关为存量设备指定的assigned FCS, false=原生FCS鉴定

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@unique([fstdId, characteristic, subsystem])
  @@map("fstd_fcs_capabilities")
}

/// 装备规格清单 ESL (AMC1/AMC2 ORA.FSTD.120): 每台FSTD证书都须配套一份(除BITD外, 含legacy设备),
/// 按14个特征组织, 版本化(新修订自动替代旧版本)。声明人须为ORA.GEN.210(b)提名的合规负责人或其代表。
model EquipmentSpecificationList {
  id             String    @id @default(cuid())
  fstdId         String
  revisionNumber String
  revisionDate   DateTime
  declaredById   String? // Personnel.id, 应持有 NOMINATED_PERSON_COMPLIANCE 角色 (ORA.GEN.210(b))
  declaredAt     DateTime?
  supersededAt   DateTime? // 被新修订版本替代的时间, null=当前有效版本
  createdAt      DateTime  @default(now())

  fstd    Fstd              @relation(fields: [fstdId], references: [id])
  entries EslFeatureEntry[]

  @@map("equipment_specification_lists")
}

/// ESL逐特征条目: legacy设备的fidelityLevel按官方模板说明留空("leave blank for a legacy FSTD")
model EslFeatureEntry {
  id                   String            @id @default(cuid())
  eslId                String
  characteristic       FcsCharacteristic
  fidelityLevel        FcsFidelityLevel?
  equipmentDescription String?
  limitations          String?

  esl EquipmentSpecificationList @relation(fields: [eslId], references: [id])

  @@unique([eslId, characteristic])
  @@map("esl_feature_entries")
}

/// 训练矩阵 (Part-FCL Appendix 9训练科目 x 14特征 -> T可开始训练/TP完成训练阈值)。
/// 全局配置表(非租户/机构范围), 与record_retention_policies同类性质——同一套Part-FCL标准适用于所有ATO。
/// 官方完整清单(AMC1 to Appendix 9 Section A point 1f)按需登记录入, 不预置整份矩阵数据以避免录入错误。
model TrainingMatrixEntry {
  id             String            @id @default(cuid())
  taskCode       String // 训练科目编号, 与legacy体系FstdQualifiedTask.taskCode共用编号体系
  taskName       String
  characteristic FcsCharacteristic
  thresholdT     FcsFidelityLevel // 可开始训练(Training)所需的最低保真度
  thresholdTP    FcsFidelityLevel // 完成训练(Training to Proficiency)所需的最低保真度

  @@unique([taskCode, characteristic])
  @@map("training_matrix_entries")
}

model FstdRecurrentEvaluation {
  id            String    @id @default(cuid())
  fstdId        String
  periodStart   DateTime
  periodEnd     DateTime
  evaluationType String   @default("standard") // standard / extended
  result        String?   // pass / fail / partial
  nextDueDate   DateTime?
  createdAt     DateTime  @default(now())

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@map("fstd_recurrent_evaluations")
}

/// 3.3.4 QTG/MQTG生命周期文档 (仅覆盖旧体系legacy相关文档类型: SOC/VDR/MQTG; SOJ/ER/ESL属新体系FCS分支, 三期实现)
enum QtgDocumentType {
  SOC // 旧体系合规声明 (Statement of Compliance)
  VDR // 验证数据路线图 (Validation Data Roadmap), 新旧体系通用
  MQTG // 主鉴定测试指南, 设备全生命周期永久保存 (ORA.FSTD.240(a))
}

model FstdQtgDocument {
  id               String          @id @default(cuid())
  fstdId           String
  documentType     QtgDocumentType
  version          String
  effectiveDate    DateTime
  pointerUrl       String? // 已上传文件: 本地磁盘存储路径; 未上传文件: 用户手填的外部引用链接(如企业内部文档系统地址)
  originalFileName String? // 上传文件的原始文件名, 仅上传时有值
  mimeType         String?
  fileSize         Int? // 字节数
  supersededAt     DateTime? // 被新版本替代的时间, null=当前有效版本
  createdAt        DateTime        @default(now())

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@map("fstd_qtg_documents")
}

/// 年度QTG按季度滚动运行记录 (吸收FAA细节: 不允许年检前突击补测, 呼应AMC1 FSTD(A).300(a)(9))
model FstdQtgQuarterlyRun {
  id          String    @id @default(cuid())
  fstdId      String
  year        Int
  quarter     Int // 1-4
  completedAt DateTime?
  result      String? // pass / fail / partial
  notes       String?
  createdAt   DateTime  @default(now())

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@unique([fstdId, year, quarter])
  @@map("fstd_qtg_quarterly_runs")
}

/// 安全设施年检 (3.3.8, ORA.FSTD.115(b)): 急停/应急照明等, 每年至少检查一次并记录
model FstdSafetyFacilityCheck {
  id            String   @id @default(cuid())
  fstdId        String
  checkedAt     DateTime
  checkedById   String? // Personnel.id
  itemsJson     Json // [{ item: "急停按钮", passed: true, notes: string }, ...]
  overallResult String // pass / issues_found
  nextDueDate   DateTime // checkedAt + 12个月 (标准年度周期)
  createdAt     DateTime @default(now())

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@map("fstd_safety_facility_checks")
}

/// 缺陷/故障处理 (吸收FAA 30天规则 + Kiosk交互模式)
model DiscrepancyLog {
  id              String    @id @default(cuid())
  fstdId          String
  reportedById    String? // Personnel.id, 也可来自Kiosk匿名报障
  reportedAt      DateTime  @default(now())
  description     String
  isMmi           Boolean   @default(false) // Missing/Malfunctioning/Inoperative
  severityRating  Int? // Kiosk打分 1-5, 5为最严重 (对标Simorg)
  trainingTimeLostMinutes Int? // Kiosk记录培训损失时间(分钟)
  correctiveAction String?
  correctedById   String?
  correctedAt     DateTime?
  status          String    @default("open") // open / corrected
  dueDate         DateTime? // 默认报告时间+30天 (吸收FAA §60.25规则)

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@map("discrepancy_logs")
}

model FstdChangeRequest {
  id          String   @id @default(cuid())
  fstdId      String
  changeType  String // update / upgrade / major_modification / relocation / deactivation / transfer
  description String?
  notifiedAuthorityAt DateTime?
  status      String   @default("draft")
  createdAt   DateTime @default(now())

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@map("fstd_change_requests")
}

// ============================================================
// 3.4 备件/工具/校准管理 (对标 Simorg Inventory & Tool)
// ============================================================

model SparePart {
  id             String   @id @default(cuid())
  organizationId String
  partNumber     String
  name           String
  compatibleWith String? // 按配置树关联使用类型, 一期简化为文本描述, 如 "A320 FFS" / "通用"
  unit           String  @default("pcs")
  minQuantity    Int     @default(0)
  currentQuantity Int    @default(0)
  location       String?
  createdAt      DateTime @default(now())

  organization      Organization        @relation(fields: [organizationId], references: [id])
  movements          PartMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([organizationId, partNumber])
  @@map("spare_parts")
}

enum PartMovementType {
  IN
  OUT
  ADJUSTMENT
}

/// 备件出入库记录, currentQuantity 由此累计得出
model PartMovement {
  id                  String           @id @default(cuid())
  sparePartId         String
  type                PartMovementType
  quantity            Int // ADJUSTMENT 可为负数表示盘亏
  relatedDiscrepancyId String? // 可关联到消耗该备件的缺陷维修记录 (DiscrepancyLog.id)
  note                String?
  performedAt         DateTime         @default(now())

  sparePart SparePart @relation(fields: [sparePartId], references: [id])

  @@map("part_movements")
}

model Tool {
  id                       String   @id @default(cuid())
  organizationId           String
  toolCode                 String
  name                     String
  category                 String?
  location                 String?
  calibrationIntervalMonths Int     @default(12)
  createdAt                DateTime @default(now())

  organization Organization             @relation(fields: [organizationId], references: [id])
  calibrations ToolCalibrationRecord[]

  @@unique([organizationId, toolCode])
  @@map("tools")
}

model ToolCalibrationRecord {
  id            String    @id @default(cuid())
  toolId        String
  calibratedAt  DateTime
  result        String    @default("pass") // pass / fail
  nextDueDate   DateTime?
  performedBy   String?
  createdAt     DateTime  @default(now())

  tool Tool @relation(fields: [toolId], references: [id])

  @@map("tool_calibration_records")
}

model Supplier {
  id              String  @id @default(cuid())
  organizationId  String
  name            String
  serviceCategory String?
  contactInfo     String?

  organization    Organization     @relation(fields: [organizationId], references: [id])
  purchaseOrders  PurchaseOrder[]

  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  organizationId String
  supplierId     String
  status         PurchaseOrderStatus @default(DRAFT)
  createdAt      DateTime            @default(now())
  approvedAt     DateTime?
  receivedAt     DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id])
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  items        PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  sparePartId     String
  quantity        Int
  unitPrice       Float?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  sparePart     SparePart     @relation(fields: [sparePartId], references: [id])

  @@map("purchase_order_items")
}

// ============================================================
// 3.5 人员资质管理
// ============================================================

model Personnel {
  id        String   @id @default(cuid())
  tenantId  String
  firstName String
  lastName  String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  roleAssignments   PersonnelRoleAssignment[]
  instructorProfile InstructorProfile?
  qualifications    QualificationRecord[]
  user              User?

  @@map("personnel")
}

enum InstructorType {
  FI // Flight Instructor
  TRI // Type Rating Instructor
  SFI // Synthetic Flight Instructor
  THEORETICAL
  EXAMINER
}

model InstructorProfile {
  id           String         @id @default(cuid())
  personnelId  String         @unique
  instructorType InstructorType

  personnel Personnel @relation(fields: [personnelId], references: [id])

  @@map("instructor_profiles")
}

/// 通用证照/资质记录 + 到期提醒 (人员/学员/设备均可复用此模式, 此处聚焦人员)
model QualificationRecord {
  id              String    @id @default(cuid())
  personnelId     String
  qualificationType String // 执照类型/教员证/考试员证等
  certificateNo   String?
  issuingAuthority String?
  validFrom       DateTime?
  validUntil      DateTime?
  reminderSentAt  DateTime?
  createdAt       DateTime  @default(now())

  personnel Personnel @relation(fields: [personnelId], references: [id])

  @@map("qualification_records")
}

// ============================================================
// 3.6 课程/培训大纲管理 (一期基础版, 不含ZFTT/MPL等特殊课程)
// ============================================================

enum CourseType {
  LAPL
  PPL
  CPL
  MPL
  ATPL
  INSTRUMENT_RATING
  TYPE_RATING
  OTHER
}

model Course {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  courseType     CourseType
  isApproved     Boolean    @default(false)
  approvedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization      Organization                       @relation(fields: [organizationId], references: [id])
  trainingProgramme  TrainingProgramme?
  courseApprovals    TrainingCourseApprovalAttachment[]
  enrollments        Enrollment[]
  requirements       CourseRequirement[]

  @@map("courses")
}

/// 课程对训练科目的要求 (旧体系: 课程直接与设备等级/科目挂钩, 需求清单3.3.3/3.6)
/// taskCode 与 FstdQualifiedTask.taskCode 使用同一套科目编号体系, 用于校验某设备是否满足课程全部要求
model CourseRequirement {
  id       String  @id @default(cuid())
  courseId String
  taskCode String
  taskName String
  minHours Float?

  course Course @relation(fields: [courseId], references: [id])
  trainingRecords TrainingRecord[]

  @@map("course_requirements")
}

/// ORA.ATO.125 训练大纲
model TrainingProgramme {
  id              String  @id @default(cuid())
  courseId        String  @unique
  stagesJson       Json? // 周/阶段分解表 (CPL/MPL/ATPL类需要)
  standardTasksJson Json? // 标准科目清单
  summary         String?

  course Course @relation(fields: [courseId], references: [id])

  @@map("training_programmes")
}

// ============================================================
// 3.7 学员培训记录管理
// ============================================================

model Student {
  id                    String    @id @default(cuid())
  organizationId        String
  firstName             String
  lastName              String
  licenceNo             String?
  medicalCertExpiry     DateTime? // ORA.ATO.120(c) 强制记录字段, 训练前置条件校验依赖此字段
  createdAt             DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  enrollments  Enrollment[]

  @@map("students")
}

model Enrollment {
  id           String    @id @default(cuid())
  studentId    String
  courseId     String
  enrolledAt   DateTime  @default(now())
  completedAt  DateTime?
  status       String    @default("active") // active / completed / withdrawn

  student Student @relation(fields: [studentId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])
  trainingRecords TrainingRecord[]

  @@map("enrollments")
}

/// 训练全程 + 结课后3年保存 (ORA.ATO.120)
model TrainingRecord {
  id                  String   @id @default(cuid())
  enrollmentId        String
  courseRequirementId String? // 关联到课程要求的具体训练科目 (3.6 CourseRequirement), 用于生成进度卡; 留空则为不挂钩具体科目的地面训练记录
  sessionDate         DateTime
  subject             String
  progressNotes       String?
  testScore           String?
  assessedById        String? // Personnel.id
  createdAt           DateTime @default(now())

  enrollment        Enrollment         @relation(fields: [enrollmentId], references: [id])
  courseRequirement CourseRequirement? @relation(fields: [courseRequirementId], references: [id])

  @@map("training_records")
}

// ============================================================
// 3.8 排班与预订 (基础版: 资源日历)
// ============================================================

enum BookingResourceType {
  FSTD
  CLASSROOM
  INSTRUCTOR
}

model Booking {
  id             String              @id @default(cuid())
  organizationId String // 补充: 租户隔离校验需要, 排课资源始终归属某一机构
  resourceType   BookingResourceType
  resourceId     String // Fstd.id / classroom id / Personnel.id, 视 resourceType 而定
  courseId       String?
  studentId      String?
  taskCode       String? // resourceType=FSTD 时可指定具体训练科目, 用于校验该设备是否已鉴定该科目
  startAt        DateTime
  endAt          DateTime
  status         String              @default("confirmed") // confirmed / cancelled
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([resourceType, resourceId, startAt])
  @@map("bookings")
}
