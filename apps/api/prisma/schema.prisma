// 培训中心管理系统 - 数据模型 (EASA主线, 对应 培训中心管理系统_需求清单.md 第一期MVP范围)
// 模块编号对应需求清单第3节: 3.1机构 / 3.2管理体系 / 3.3模拟机 / 3.5人员 / 3.6课程 / 3.7学员 / 3.8排班

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 通用: 多租户 + 审计 + 变更管理 (跨模块基础设施)
// ============================================================

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  organizations Organization[]
  users         User[]
  notifications Notification[]

  @@map("tenants")
}

enum UserRole {
  OWNER // 租户创建者/最高权限, 注册时自动生成, 不可通过用户管理接口创建或编辑
  ADMIN // 管理账户: 可管理其他账户及其模块权限, 对全部模块拥有完全访问权限
  STAFF // 普通账户: 对各模块的访问权限由 permissions 字段逐项授予
}

/// 模块级功能权限, 仅对 STAFF 账户生效 (OWNER/ADMIN 始终拥有全部模块的完全访问权限)。
/// 与 ManagementRoleType (航空法规意义上的"提名人员"角色) 是完全不同的概念, 互不影响。
enum Permission {
  ORGANIZATION // 机构与证书
  MANAGEMENT_SYSTEM // 管理体系 SMS/QMS (含数据留存合规看板)
  FSTD // 模拟机(FSTD)
  INVENTORY // 备件/工具管理
  PERSONNEL // 人员资质
  COURSES // 课程管理
  STUDENTS // 学员记录
  SCHEDULING // 排班预订
  ISMS // 信息安全 ISMS
}

/// 登录账号 (认证主体), 与 Personnel (航空业务人员档案) 是可选的一对一关联而非同一实体——
/// 不是每个登录账号都对应一名受监管的航空人员(如纯IT管理员), 也不是每个Personnel都需要登录权限
model User {
  id           String       @id @default(cuid())
  tenantId     String
  email        String       @unique
  passwordHash String
  role         UserRole     @default(STAFF)
  permissions  Permission[] // 仅STAFF账户使用, 由OWNER/ADMIN在用户管理页面逐项授予
  isActive     Boolean      @default(true) // false=已停用, 登录态立即失效 (JwtStrategy每次请求都会重新校验)
  personnelId  String?      @unique
  createdAt    DateTime     @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  personnel     Personnel?     @relation(fields: [personnelId], references: [id])
  notifications Notification[]

  @@map("users")
}

/// 站内通知: recipientUserId 为空代表该条目仅用于去重标记(对应人员没有登录账户, 只走短信/无法送达)。
/// 同一 (entityType, entityId) 只应生成一次通知(由调用方在创建前检查), 避免每次定时任务运行都重复提醒。
model Notification {
  id              String    @id @default(cuid())
  tenantId        String
  recipientUserId String?
  title           String
  message         String
  entityType      String?
  entityId        String?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  tenant        Tenant @relation(fields: [tenantId], references: [id])
  recipientUser User?  @relation(fields: [recipientUserId], references: [id])

  @@index([tenantId, recipientUserId, readAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

/// 通用审计轨迹, 覆盖所有需要"可追溯/防篡改"的实体变更 (ORA.GEN.220)
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  entityType String // 如 "Organization" / "Fstd" / "OrganizationCertificate"
  entityId   String
  action     String // create / update / delete / status_change
  actorId    String? // 操作人 (Personnel.id), 系统自动操作为 null
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

/// 变更管理通用状态机 (ORA.GEN.130), 供机构变更/课程变更/FSTD变更复用
enum ChangeApprovalType {
  PRIOR_APPROVAL // 需事先批准 (提前≥30天, 人员变更≥10天)
  NOTIFICATION_ONLY // 无需事先批准, 按内部程序执行后通知当局
}

enum ChangeRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  LOGGED
  NOTIFIED
}

/// 通用变更管理 (ORA.GEN.130): 供机构(3.1)/FSTD(3.3.6)等模块共用同一套状态机与审计轨迹,
/// 不同entityType+changeType的审批类型/提前通知天数/所需详情字段由 change-management 模块的静态配置表决定。
model ChangeRequest {
  id                    String              @id @default(cuid())
  tenantId              String
  entityType            String // "Organization" / "Fstd"
  entityId              String
  changeType            String // 机构: NAME/SCOPE/ACCOUNTABLE_MANAGER等; FSTD: UPDATE/UPGRADE/MAJOR_MODIFICATION等 (3.3.6)
  approvalType          ChangeApprovalType
  status                ChangeRequestStatus @default(DRAFT)
  description           String?
  detailsJson           Json? // 特定变更类型所需的结构化详情, 如FSTD重大改装的impactAssessment/搬迁的验证测试完成百分比
  beforeJson            Json?
  afterJson             Json?
  minNoticeDays         Int? // 创建时按changeType快照的最低提前通知天数, 即使后续配置调整也不影响已创建的变更单
  submittedAt           DateTime?
  earliestEffectiveDate DateTime? // submittedAt + minNoticeDays, 批准生效日期不得早于此日期
  effectiveAt           DateTime?
  authorityReply        String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([tenantId, entityType, entityId])
  @@map("change_requests")
}

/// 记录保存策略引擎配置表 (需求清单 3.9)
model RecordRetentionPolicy {
  id              String  @id @default(cuid())
  documentType    String  @unique // 如 "student_training_record" / "fstd_mqtg" / "audit_finding"
  retentionMonths Int? // null = 永久保存 (如 MQTG/初始鉴定记录)
  anchorEvent     String  @default("created_at") // 保存期起算点: "created_at" | "enrollment_completed_at"
  basisRegulation String? // 法规依据, 如 "ORA.ATO.120"
  description     String?

  @@map("record_retention_policies")
}

// ============================================================
// 3.1 机构与ATO证书管理
// ============================================================

enum OrganizationType {
  EASA_ATO
  EASA_ATO_DUAL_FAA142 // 预留: 未来若需同时服务FAA Part142客户
}

/// 该机构适用的法规标准体系。CAAC 在 EASA 现有要求基础上叠加 CCAR-60(飞行模拟训练设备管理和运行规则)
/// 和 CCAR-142(飞行训练中心合格审定规则)里独有的更严格要求(如模拟机QMS、教员8小时上岗培训、
/// 24小时教学时长上限等), 而不是替换 EASA 要求 —— 界面文案/默认值会按此字段分流, 具体合规逻辑按模块逐步补齐。
enum RegulatoryStandard {
  EASA
  CAAC
}

model Organization {
  id                 String             @id @default(cuid())
  tenantId           String
  type               OrganizationType   @default(EASA_ATO)
  regulatoryStandard RegulatoryStandard @default(EASA)
  name               String
  address            String?
  competentAuthority String? // 主管当局名称
  isComplexOrg       Boolean            @default(false) // AMC1 ORA.GEN.200(b) 复杂/非复杂机构判定
  complexOrgReason   String? // 触发复杂机构判定的具体原因 (>20FTE / FFS训练 / MP / ZFTT / 多场地 等)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant                      Tenant                       @relation(fields: [tenantId], references: [id])
  certificates                OrganizationCertificate[]
  applicationRecords          ApplicationRecord[]
  personnelAssignments        PersonnelRoleAssignment[]
  fstds                       Fstd[]
  courses                     Course[]
  students                    Student[]
  hazards                     HazardRegisterEntry[]
  auditSchedules              AuditSchedule[]
  occurrenceReports           OccurrenceReport[]
  contracts                   ContractRecord[]
  bookings                    Booking[]
  spareParts                  SparePart[]
  tools                       Tool[]
  suppliers                   Supplier[]
  purchaseOrders              PurchaseOrder[]
  safetyPolicies              SafetyPolicy[]
  managementOfChanges         ManagementOfChange[]
  emergencyResponsePlans      EmergencyResponsePlan[]
  safetyPerformanceIndicators SafetyPerformanceIndicator[]
  safetyReviewBoardMeetings   SafetyReviewBoardMeeting[]
  informationAssets           InformationAsset[]
  infoSecurityIncidents       InfoSecurityIncident[]
  selfReviews                 OrganisationalSelfReview[]
  fstdQms                     FstdQms?
  bookingCustomers            BookingCustomer[]
  shiftTypes                  ShiftType[]
  rosterGroups                RosterGroup[]
  rosterMembers               RosterMember[]
  rosterEntries               RosterEntry[]
  partDemandRequests          PartDemandRequest[]
  stocktakeSessions           StocktakeSession[]
  warehouses                  Warehouse[]
  partTypeConfigs             PartTypeConfig[]
  pmChecklistTemplates        PmChecklistTemplate[]
  dutyLogs                    DutyLog[]
  checklistTemplates          ChecklistTemplate[]
  checklistRecords            ChecklistRecord[]
  qualityMeetings             QualityMeeting[]
  qualityTrainings            QualityTraining[]
  inspectionItems             InspectionItem[]
  otherInspections            OtherInspection[]
  surveys                     Survey[]
  publicShares                PublicShare[]

  @@map("organizations")
}

/// 非复杂机构简化路径 (3.2.2, GM2 ORA.GEN.200(c)): 仅提供LAPL/PPL/SPL/BPL课程的机构,
/// 可用每日历年至少一次的机构自查代替完整SMS+合规监督流程, 结果须及时通报当局。
model OrganisationalSelfReview {
  id                  String    @id @default(cuid())
  organizationId      String
  year                Int // 日历年度, 每年至少一次
  reviewedAt          DateTime
  itemsJson           Json // [{ item: "批准范围合规", compliant: true, notes: string }, ...] (GM2 ORA.GEN.200(c)列出的11项典型检查项)
  overallResult       String // compliant / issues_found
  notifiedAuthorityAt DateTime?
  createdAt           DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, year])
  @@map("organisational_self_reviews")
}

/// CCAR-60 附录B: 飞行模拟训练设备质量管理系统, 按飞行模拟训练设备运营人(机构)建立, 覆盖其全部FSTD (60.11(e)/60.55)。
/// 是否"已建立QMS"直接决定第60.19条规定的合格证有效期档位(建立后更长, 未建立则更短), 而非EASA模式下"12个月为标准、
/// 24/36个月需专门申请延期"的例外逻辑——二者方向相反, 故CAAC机构不复用EASA的延期资格(ExtensionEligibility)流程。
model FstdQms {
  id                    String    @id @default(cuid())
  organizationId        String    @unique
  establishedAt         DateTime? // 质量管理系统建立日期; 为空视为未建立
  designatedManagerName String? // 附录B(b): 指定负责建立/纠正QMS政策措施程序并对接民航局的管理人员
  itemsJson             Json      @default("[]") // 附录B(c)(1)-(21)逐项: [{ item, compliant, notes }, ...]
  lastInternalAuditAt   DateTime? // 附录B(c)(21): 质量保证计划内部审计
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("fstd_qms")
}

enum CertificateStatus {
  ACTIVE // 持续有效 (ORA.GEN.135 Continued Validity)
  SUSPENDED
  REVOKED
  TERMINATED
}

/// 对应 EASA Form 143 模板 (ORA.ATO批准证书)
model OrganizationCertificate {
  id              String            @id @default(cuid())
  organizationId  String
  certificateNo   String
  issuedAuthority String
  regulationBasis String            @default("Regulation (EU) No 1178/2011")
  approvalScope   String // 批准范围声明文本
  status          CertificateStatus @default(ACTIVE)
  issuedAt        DateTime
  suspendedAt     DateTime?
  revokedAt       DateTime?
  terminatedAt    DateTime?
  statusReason    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization                       @relation(fields: [organizationId], references: [id])
  courseApprovals TrainingCourseApprovalAttachment[]

  @@map("organization_certificates")
}

/// 证书附件: 课程批准列表, 比证书本身更新更频繁 (一对多)
model TrainingCourseApprovalAttachment {
  id                String    @id @default(cuid())
  certificateId     String
  courseId          String
  approvedFstdCodes String[] // 可用FSTD清单 (字母代码)
  approvedAt        DateTime  @default(now())
  revokedAt         DateTime?

  certificate OrganizationCertificate @relation(fields: [certificateId], references: [id])
  course      Course                  @relation(fields: [courseId], references: [id])

  @@map("training_course_approval_attachments")
}

/// ORA.ATO.105 申请材料
model ApplicationRecord {
  id                  String    @id @default(cuid())
  organizationId      String
  isChangeApplication Boolean   @default(false) // 首次申请 vs 变更申请(仅需提交变更相关部分)
  proposedStartDate   DateTime?
  headOfTrainingInfo  Json?
  trainingSitesJson   Json? // 训练场地清单
  aircraftListJson    Json? // 航空器清单: 机型/注册号/所有人/适航证类别
  fstdListJson        Json?
  courseTypesJson     Json?
  operationsManualRef String?
  trainingManualRef   String?
  submittedAt         DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("application_records")
}

// ============================================================
// 3.2 管理体系: SMS + 合规监督(QMS)
// ============================================================

enum ManagementRoleType {
  ACCOUNTABLE_MANAGER
  NOMINATED_PERSON_COMPLIANCE
  SAFETY_MANAGER
  COMPLIANCE_MONITORING_MANAGER
  HEAD_OF_TRAINING
  CFI // 总飞行教员
  CTKI // 总理论教员
}

model PersonnelRoleAssignment {
  id             String             @id @default(cuid())
  organizationId String
  personnelId    String
  role           ManagementRoleType
  startDate      DateTime
  endDate        DateTime?
  appointmentRef String? // 任命文件编号

  organization Organization @relation(fields: [organizationId], references: [id])
  personnel    Personnel    @relation(fields: [personnelId], references: [id])

  @@map("personnel_role_assignments")
}

/// 危险源登记 (SMS核心, 二期完整实现, 一期先建表)
model HazardRegisterEntry {
  id             String   @id @default(cuid())
  organizationId String
  source         String // internal_report / audit / occurrence
  description    String
  affectedArea   String? // 涉及运行环节: 训练科目/FSTD/场地
  createdAt      DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id])
  riskAssessments RiskAssessment[]

  @@map("hazard_register_entries")
}

model RiskAssessment {
  id                 String   @id @default(cuid())
  hazardId           String
  probabilityLevel   Int
  severityLevel      Int
  riskScore          Int
  existingMitigation String?
  residualRiskLevel  Int?
  assessedAt         DateTime @default(now())

  hazard                     HazardRegisterEntry  @relation(fields: [hazardId], references: [id])
  mitigations                MitigationAction[]
  changesUsingThisAssessment ManagementOfChange[]

  @@map("risk_assessments")
}

model MitigationAction {
  id                     String    @id @default(cuid())
  riskAssessmentId       String
  description            String
  responsiblePersonnelId String?
  dueDate                DateTime?
  status                 String    @default("open") // open / in_progress / closed

  riskAssessment RiskAssessment @relation(fields: [riskAssessmentId], references: [id])

  @@map("mitigation_actions")
}

/// 安全政策 (3.2.2 SMS核心要素2): 版本化, 新版本生效时旧版本自动标记为已替代; 须由负责人(Accountable Manager)签署
model SafetyPolicy {
  id             String    @id @default(cuid())
  organizationId String
  version        String
  policyText     String
  effectiveDate  DateTime
  signedById     String? // Personnel.id, 应为负责人 Accountable Manager
  signedAt       DateTime?
  supersededAt   DateTime? // 被新版本替代的时间, null=当前生效版本
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("safety_policies")
}

/// 变更管理 MOC (3.2.2): draft -> risk_assessed -> implemented -> verified, 变更前必须完成风险评估才能实施
enum MocStatus {
  DRAFT
  RISK_ASSESSED
  IMPLEMENTED
  VERIFIED
}

model ManagementOfChange {
  id                 String    @id @default(cuid())
  organizationId     String
  changeDescription  String // 新课程/新设备/新场地等
  status             MocStatus @default(DRAFT)
  riskAssessmentId   String? // 变更前风险评估, 必须存在才能进入实施阶段
  implementationPlan String?
  implementedAt      DateTime?
  verificationNotes  String?
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id])
  riskAssessment RiskAssessment? @relation(fields: [riskAssessmentId], references: [id])

  @@map("management_of_changes")
}

/// 应急响应计划 ERP (3.2.2): 版本化预案 + 演练记录, 标准演练周期12个月
model EmergencyResponsePlan {
  id             String    @id @default(cuid())
  organizationId String
  version        String
  planText       String
  effectiveDate  DateTime
  supersededAt   DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  drills       ErpDrill[]

  @@map("emergency_response_plans")
}

model ErpDrill {
  id          String   @id @default(cuid())
  erpId       String
  drilledAt   DateTime
  scenario    String
  outcome     String?
  nextDueDate DateTime // drilledAt + 12个月 (标准年度演练周期)
  createdAt   DateTime @default(now())

  erp EmergencyResponsePlan @relation(fields: [erpId], references: [id])

  @@map("erp_drills")
}

/// 安全绩效指标 SPI/SPT (3.2.2): 指标定义+目标值, 周期采集值判断是否达标
enum SpiDirection {
  LOWER_IS_BETTER // 如: 事件率, 数值越低越好
  HIGHER_IS_BETTER // 如: 培训完成率, 数值越高越好
}

model SafetyPerformanceIndicator {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  targetValue    Float // SPT (Safety Performance Target)
  direction      SpiDirection @default(LOWER_IS_BETTER)
  createdAt      DateTime     @default(now())

  organization Organization                   @relation(fields: [organizationId], references: [id])
  measurements SafetyPerformanceMeasurement[]

  @@map("safety_performance_indicators")
}

model SafetyPerformanceMeasurement {
  id          String   @id @default(cuid())
  indicatorId String
  periodStart DateTime
  periodEnd   DateTime
  value       Float
  createdAt   DateTime @default(now())

  indicator SafetyPerformanceIndicator @relation(fields: [indicatorId], references: [id])

  @@map("safety_performance_measurements")
}

/// 安全评审委员会会议 (3.2.2, 复杂机构): 会议+决议+行动跟踪, 复用类似缓解措施的开闭状态
model SafetyReviewBoardMeeting {
  id             String   @id @default(cuid())
  organizationId String
  meetingDate    DateTime
  attendeeRoles  String[] // ManagementRoleType 值的数组
  agenda         String
  decisions      String?
  createdAt      DateTime @default(now())

  organization Organization              @relation(fields: [organizationId], references: [id])
  actions      SafetyReviewBoardAction[]

  @@map("safety_review_board_meetings")
}

model SafetyReviewBoardAction {
  id                     String    @id @default(cuid())
  meetingId              String
  description            String
  responsiblePersonnelId String?
  dueDate                DateTime?
  status                 String    @default("open") // open / closed

  meeting SafetyReviewBoardMeeting @relation(fields: [meetingId], references: [id])

  @@map("safety_review_board_actions")
}

/// 事件报告 (ORA.GEN.160), 72小时强制上报倒计时是核心告警需求
model OccurrenceReport {
  id                String    @id @default(cuid())
  organizationId    String
  discoveredAt      DateTime // 用于计算72小时时限起点
  reportedAt        DateTime?
  occurrenceType    String
  involvedPersonnel String?
  involvedAircraft  String?
  involvedFstdId    String?
  isMandatory       Boolean   @default(true) // 强制 vs 自愿报告
  reportedTo        String? // 主管当局 / 设计批准持有人 等
  followUpStatus    String?   @default("pending")
  createdAt         DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("occurrence_reports")
}

/// 合规监督闭环: audit_schedule -> audit_task -> finding -> corrective_action -> closure
model AuditSchedule {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  scopeTag       String   @default("organization") // "organization" | "fstd" (3.2.6 FSTD专项复用同一闭环)
  plannedAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  tasks        AuditTask[]

  @@map("audit_schedules")
}

model AuditTask {
  id              String    @id @default(cuid())
  auditScheduleId String
  auditorId       String? // 必须独立于被审核职能
  scope           String
  performedAt     DateTime?
  status          String    @default("planned") // planned / in_progress / completed

  auditSchedule AuditSchedule @relation(fields: [auditScheduleId], references: [id])
  findings      Finding[]

  @@map("audit_tasks")
}

model Finding {
  id          String   @id @default(cuid())
  auditTaskId String
  level       Int // 1 或 2, 对应 ARA.GEN.350
  description String
  rootCause   String?
  createdAt   DateTime @default(now())

  auditTask         AuditTask          @relation(fields: [auditTaskId], references: [id])
  correctiveActions CorrectiveAction[]

  @@map("findings")
}

model CorrectiveAction {
  id                     String    @id @default(cuid())
  findingId              String
  planDescription        String
  responsiblePersonnelId String?
  dueDate                DateTime?
  status                 String    @default("open") // open / verifying / closed
  closedAt               DateTime?

  finding Finding @relation(fields: [findingId], references: [id])

  @@map("corrective_actions")
}

model ContractRecord {
  id              String   @id @default(cuid())
  organizationId  String
  contractorName  String
  scope           String
  agreementRef    String?
  includedInAudit Boolean  @default(true)
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("contract_records")
}

// ============================================================
// 3.2.4 信息安全管理体系 ISMS ((EU) 2023/203, 2026-02-22起适用, 独立于Part-ORA的SMS)
// ============================================================

enum InfoAssetCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL // 直接影响飞行训练安全的资产 (如FSTD控制系统/学员资质数据库)
}

/// 信息资产清单
model InformationAsset {
  id               String               @id @default(cuid())
  organizationId   String
  name             String
  category         String // 如: 数据库/网络设备/云服务/终端设备/第三方系统
  criticality      InfoAssetCriticality @default(MEDIUM)
  ownerPersonnelId String?
  description      String?
  createdAt        DateTime             @default(now())

  organization    Organization                 @relation(fields: [organizationId], references: [id])
  riskAssessments InfoSecurityRiskAssessment[]
  incidents       InfoSecurityIncident[]

  @@map("information_assets")
}

/// 信息安全风险评估: 复用SMS风险矩阵模式 (概率x影响), 保持系统内两套风险评估体验一致
model InfoSecurityRiskAssessment {
  id                String   @id @default(cuid())
  assetId           String
  likelihoodLevel   Int // 1-5
  impactLevel       Int // 1-5
  riskScore         Int // likelihoodLevel x impactLevel
  existingControls  String?
  residualRiskLevel Int?
  assessedAt        DateTime @default(now())

  asset       InformationAsset               @relation(fields: [assetId], references: [id])
  mitigations InfoSecurityMitigationAction[]

  @@map("info_security_risk_assessments")
}

model InfoSecurityMitigationAction {
  id                     String    @id @default(cuid())
  riskAssessmentId       String
  description            String
  responsiblePersonnelId String?
  dueDate                DateTime?
  status                 String    @default("open") // open / in_progress / closed

  riskAssessment InfoSecurityRiskAssessment @relation(fields: [riskAssessmentId], references: [id])

  @@map("info_security_mitigation_actions")
}

/// 信息安全事件响应: OPEN -> CONTAINED -> RESOLVED, 参照NIST事件响应流程(遏制先于解决)
enum InfoSecurityIncidentStatus {
  OPEN
  CONTAINED
  RESOLVED
}

model InfoSecurityIncident {
  id              String                     @id @default(cuid())
  organizationId  String
  discoveredAt    DateTime
  incidentType    String // 如: 未授权访问/数据泄露/勒索软件/系统中断/钓鱼攻击
  description     String
  affectedAssetId String?
  severity        Int // 1-5
  status          InfoSecurityIncidentStatus @default(OPEN)
  responseActions String?
  containedAt     DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime                   @default(now())

  organization  Organization      @relation(fields: [organizationId], references: [id])
  affectedAsset InformationAsset? @relation(fields: [affectedAssetId], references: [id])

  @@map("info_security_incidents")
}

// ============================================================
// 3.3 模拟机资质与技术管理 (一期仅 legacy 等级字典, 不做FCS矩阵)
// ============================================================

enum FstdQualificationBasisType {
  EASA_LEGACY_LEVEL
  EASA_FCS // 二期/三期启用
  CCAR_60 // 中国民航局 CCAR-60 鉴定: 等级为 FFS A-D / FTD 1-7, 能力按已鉴定科目清单二元判定(与 legacy 同一分支)
}

enum FstdDeviceType {
  FFS
  FTD
  FNPT
  BITD
}

model Fstd {
  id                             String                     @id @default(cuid())
  organizationId                 String
  deviceCode                     String // 设备编号
  serialNumber                   String?
  representedAircraft            String // 代表机型/机型组
  deviceType                     FstdDeviceType
  qualificationBasisType         FstdQualificationBasisType @default(EASA_LEGACY_LEVEL)
  qualificationBasisVersion      String? // 初始鉴定采用的标准版本, 后续周期性鉴定持续沿用
  location                       String?
  status                         String                     @default("active") // active / deactivated / relocating / decommissioned
  isLargeAircraftPublicTransport Boolean                    @default(false) // CCAR-60第60.19条(a)款: 模拟大型飞机(多发、公共航空运输)的FFS适用独立的有效期档位(12/6个月), 区别于(b)款其他FSTD的24/36或12/18个月档位
  createdAt                      DateTime                   @default(now())
  updatedAt                      DateTime                   @updatedAt

  organization                Organization                 @relation(fields: [organizationId], references: [id])
  legacyLevel                 FstdLegacyLevel?
  qualifiedTasks              FstdQualifiedTask[]
  fcsCapabilities             FstdFcsCapability[]
  equipmentSpecificationLists EquipmentSpecificationList[]
  recurrentEvals              FstdRecurrentEvaluation[]
  safetyFacilityChecks        FstdSafetyFacilityCheck[]
  preFlightChecks             FstdPreFlightCheck[]
  groundings                  FstdGrounding[]
  checklistTemplates          ChecklistTemplate[]
  checklistRecords            ChecklistRecord[]
  upgradeRecords              FstdUpgradeRecord[]
  qtgPlans                    FstdQtgPlan[]
  discrepancies               DiscrepancyLog[]
  qtgDocuments                FstdQtgDocument[]
  qtgQuarterlyRuns            FstdQtgQuarterlyRun[]
  performanceMetrics          FstdPerformanceMetric[]
  faultyPartRecords           FaultyPartRecord[]
  pmTasks                     PmTask[]

  @@unique([organizationId, deviceCode])
  @@map("fstds")
}

enum LegacyLevel {
  FFS_A
  FFS_B
  FFS_C
  FFS_D
  FTD_1
  FTD_2
  FTD_3 // FTD 3-7 仅用于 CCAR_60 鉴定基础 (CCAR-60 第60.71条)
  FTD_4
  FTD_5
  FTD_6
  FTD_7
  FNPT_I
  FNPT_II
  FNPT_II_MCC
  BITD
}

model FstdLegacyLevel {
  id     String      @id @default(cuid())
  fstdId String      @unique
  level  LegacyLevel

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@map("fstd_legacy_levels")
}

/// 已鉴定任务清单 (连接设备与训练), 一期用课程直接挂钩等级的方式, 训练矩阵留待FCS体系(三期)
model FstdQualifiedTask {
  id                  String  @id @default(cuid())
  fstdId              String
  taskCode            String // 训练科目编号
  taskName            String
  requiresSpecialAuth Boolean @default(false)

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@map("fstd_qualified_tasks")
}

// ============================================================
// 3.3.2/3.3.3 FCS能力矩阵与训练矩阵 (CS-FSTD Issue 1, qualificationBasisType=EASA_FCS时启用, 三期)
// ============================================================

/// 14个特征 (核对 AMC/GM to Part-FCL Issue 1 Amdt 15, GM1 to Appendix 9 Section A point 1g):
/// 飞机仿真特征(7) + 感知/线索仿真特征(Cueing, 4) + 环境仿真特征(3)。
/// 注: "运动仿真"缩写在两份2026年官方新文件中不一致——AMC/GM to Part-FCL写作MNT,
/// AMC/GM to Part-ORA的ESL模板写作MTN; 本系统采用MTN(与ESL模板一致), 待官方勘误后再确认。
enum FcsCharacteristic {
  FDK // 飞行甲板布局与结构 Flight deck layout and structure
  CLH // 飞行操纵力与硬件 Flight controls forces and hardware
  CLO // 飞行操纵系统操作 Flight controls systems operation
  SYS // 飞机系统 Aircraft systems (支持子系统展开: 自动驾驶/FMS/液压等)
  GND // 地面性能与操作 Performance and handling on ground
  IGE // 地面效应内性能与操作 Performance and handling in ground effect
  OGE // 地面效应外性能与操作 Performance and handling out of ground effect
  SND // 声音仿真 Sound cueing
  VIB // 振动仿真 Vibration cueing
  MTN // 运动仿真 Motion cueing (官方缩写不一致, 见上方说明)
  VIS // 视景仿真 Visual cueing
  NAV // 导航 Navigation
  ATM // 大气与天气 Atmosphere and weather
  OST // 运行场地与地形 Operating sites and terrain
}

/// 4级保真度, 顺序 N < G < R < S
enum FcsFidelityLevel {
  N // None 无
  G // Generic 通用
  R // Representative 代表
  S // Specific 专用
}

/// FCS能力矩阵: 设备在14个特征上各自的保真度; SYS特征可按子系统(如autopilot/FMS/hydraulics)展开多条记录
model FstdFcsCapability {
  id             String            @id @default(cuid())
  fstdId         String
  characteristic FcsCharacteristic
  fidelityLevel  FcsFidelityLevel
  subsystem      String? // 仅SYS特征展开使用, 其余特征为null
  isAssigned     Boolean           @default(false) // true=主管机关为存量设备指定的assigned FCS, false=原生FCS鉴定

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@unique([fstdId, characteristic, subsystem])
  @@map("fstd_fcs_capabilities")
}

/// 装备规格清单 ESL (AMC1/AMC2 ORA.FSTD.120): 每台FSTD证书都须配套一份(除BITD外, 含legacy设备),
/// 按14个特征组织, 版本化(新修订自动替代旧版本)。声明人须为ORA.GEN.210(b)提名的合规负责人或其代表。
model EquipmentSpecificationList {
  id             String    @id @default(cuid())
  fstdId         String
  revisionNumber String
  revisionDate   DateTime
  declaredById   String? // Personnel.id, 应持有 NOMINATED_PERSON_COMPLIANCE 角色 (ORA.GEN.210(b))
  declaredAt     DateTime?
  supersededAt   DateTime? // 被新修订版本替代的时间, null=当前有效版本
  createdAt      DateTime  @default(now())

  fstd    Fstd              @relation(fields: [fstdId], references: [id])
  entries EslFeatureEntry[]

  @@map("equipment_specification_lists")
}

/// ESL逐特征条目: legacy设备的fidelityLevel按官方模板说明留空("leave blank for a legacy FSTD")
model EslFeatureEntry {
  id                   String            @id @default(cuid())
  eslId                String
  characteristic       FcsCharacteristic
  fidelityLevel        FcsFidelityLevel?
  equipmentDescription String?
  limitations          String?

  esl EquipmentSpecificationList @relation(fields: [eslId], references: [id])

  @@unique([eslId, characteristic])
  @@map("esl_feature_entries")
}

/// 训练矩阵 (Part-FCL Appendix 9训练科目 x 14特征 -> T可开始训练/TP完成训练阈值)。
/// 全局配置表(非租户/机构范围), 与record_retention_policies同类性质——同一套Part-FCL标准适用于所有ATO。
/// 官方完整清单(AMC1 to Appendix 9 Section A point 1f)按需登记录入, 不预置整份矩阵数据以避免录入错误。
model TrainingMatrixEntry {
  id             String            @id @default(cuid())
  taskCode       String // 训练科目编号, 与legacy体系FstdQualifiedTask.taskCode共用编号体系
  taskName       String
  characteristic FcsCharacteristic
  thresholdT     FcsFidelityLevel // 可开始训练(Training)所需的最低保真度
  thresholdTP    FcsFidelityLevel // 完成训练(Training to Proficiency)所需的最低保真度

  @@unique([taskCode, characteristic])
  @@map("training_matrix_entries")
}

model FstdRecurrentEvaluation {
  id             String    @id @default(cuid())
  fstdId         String
  periodStart    DateTime
  periodEnd      DateTime
  evaluationType String    @default("standard") // standard / extended
  result         String? // pass / fail / partial
  nextDueDate    DateTime?
  createdAt      DateTime  @default(now())

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@map("fstd_recurrent_evaluations")
}

/// 3.3.4 QTG/MQTG生命周期文档 (仅覆盖旧体系legacy相关文档类型: SOC/VDR/MQTG; SOJ/ER/ESL属新体系FCS分支, 三期实现)
enum QtgDocumentType {
  SOC // 旧体系合规声明 (Statement of Compliance)
  VDR // 验证数据路线图 (Validation Data Roadmap), 新旧体系通用
  MQTG // 主鉴定测试指南, 设备全生命周期永久保存 (ORA.FSTD.240(a))
}

model FstdQtgDocument {
  id               String          @id @default(cuid())
  fstdId           String
  documentType     QtgDocumentType
  version          String
  effectiveDate    DateTime
  pointerUrl       String? // 已上传文件: 本地磁盘存储路径; 未上传文件: 用户手填的外部引用链接(如企业内部文档系统地址)
  originalFileName String? // 上传文件的原始文件名, 仅上传时有值
  mimeType         String?
  fileSize         Int? // 字节数
  supersededAt     DateTime? // 被新版本替代的时间, null=当前有效版本
  createdAt        DateTime        @default(now())

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@map("fstd_qtg_documents")
}

/// 年度QTG按季度滚动运行记录 (吸收FAA细节: 不允许年检前突击补测, 呼应AMC1 FSTD(A).300(a)(9))
model FstdQtgQuarterlyRun {
  id          String    @id @default(cuid())
  fstdId      String
  year        Int
  quarter     Int // 1-4
  completedAt DateTime?
  result      String? // pass / fail / partial
  notes       String?
  createdAt   DateTime  @default(now())

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@unique([fstdId, year, quarter])
  @@map("fstd_qtg_quarterly_runs")
}

/// FSTD性能指标 (AMC1 ORA.FSTD.100(d)): 逐月记录, 每年至少向主管机关提交一次(含月度及汇总)。
/// 各时间字段单位为小时, 与官方原文一致。可用率/可靠率/停机时间/损失训练时间均由服务层按官方公式计算, 不落库。
model FstdPerformanceMetric {
  id                     String   @id @default(cuid())
  fstdId                 String
  year                   Int
  month                  Int // 1-12
  plannedAvailableHours  Float // Planned available time
  scheduledTrainingHours Float // Scheduled training time
  supportHours           Float // FSTD support time (计划性不可用: 停用/维护/工程/监管/构型切换等)
  fstdFailureHours       Float // FSTD failure time (设备自身故障导致的损失时间)
  externalFailureHours   Float // External failure time (外部因素导致的损失时间: 设施/用户/排期/环境等)
  lostTrainingHours      Float // Lost training time: 因FSTD停机未能交付的已排期训练时间(官方未给出可推导公式, 单独上报)
  discrepancyCount       Int // Number of FSTD discrepancies
  interruptionCount      Int // Number of interruptions during scheduled training time
  createdAt              DateTime @default(now())

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@unique([fstdId, year, month])
  @@map("fstd_performance_metrics")
}

/// 安全设施年检 (3.3.8, ORA.FSTD.115(b)): 急停/应急照明等, 每年至少检查一次并记录
model FstdSafetyFacilityCheck {
  id            String   @id @default(cuid())
  fstdId        String
  checkedAt     DateTime
  checkedById   String? // Personnel.id
  itemsJson     Json // [{ item: "急停按钮", passed: true, notes: string }, ...]
  overallResult String // pass / issues_found
  nextDueDate   DateTime // checkedAt + 12个月 (标准年度周期)
  createdAt     DateTime @default(now())

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@map("fstd_safety_facility_checks")
}

/// CCAR-60第60.37条(a)(2)(3): 每个飞行日历日开始使用前的飞行前功能检查, 以及每7个连续日历日内至少一次的保底检查要求
/// (同一份检查同时满足两款——每日使用前做一次即可, 7天窗口用于设备未使用日子的兜底)。检查内容见(c)款: 外部液压/气源/
/// 电器连接、运动系统行程范围无障碍物、故障记录核查、主要系统通电/视景/声音/起落架襟翼等完整功能性检查序列, 共14项。
model FstdPreFlightCheck {
  id            String   @id @default(cuid())
  fstdId        String
  checkDate     DateTime // 检查对应的日历日 (非精确时间戳), 用于按日去重和7天窗口计算
  performedById String? // Personnel.id, 执行检查的人员
  itemsJson     Json // [{ item: "...", passed: true, notes: string }, ...] (60.37条(c)款14项)
  overallResult String // pass / issues_found
  nextDueDate   DateTime // checkDate + 7个日历日 (60.37条(a)(3)保底周期)
  createdAt     DateTime @default(now())

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@unique([fstdId, checkDate])
  @@map("fstd_pre_flight_checks")
}

/// 停飞日历 (R3): 设备在某个日历日(北京时间)停飞。该日不接受预订, 且不再触发该设备的飞行前功能检查超期告警。
/// 只能标记当天及以后的日期; 过去的记录作为历史保留, 不可修改。
model FstdGrounding {
  id        String   @id @default(cuid())
  fstdId    String
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  fstd Fstd @relation(fields: [fstdId], references: [id])

  @@unique([fstdId, date])
  @@map("fstd_groundings")
}

/// 3.3.10 常规维护(PM)排期: 独立于3.3.4 QTG(按季度滚动)和3.3.5周期性评估(按年/三年)的第三套周期性机制,
/// 服务于机构内部更高频的日常维护节奏, 与3.3.7缺陷处理共享"设备技术记录"入口 (吸收天津飞安实践)。
enum PmCheckLevel {
  WEEKLY
  MONTHLY
  SEMI_ANNUAL
  ANNUAL
}

/// 每层级对应一套可配置检查单模板 (而非硬编码检查项), 每机构每层级一套
model PmChecklistTemplate {
  id             String       @id @default(cuid())
  organizationId String
  level          PmCheckLevel
  itemsJson      Json // [{ item: "检查刹车片磨损" }, ...] 机构可自行配置的检查项列表
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  tasks        PmTask[]

  @@unique([organizationId, level])
  @@map("pm_checklist_templates")
}

enum PmTaskStatus {
  PENDING_REVIEW // 执行人已完成登记, 待审核
  APPROVED
  REJECTED
}

/// 执行→审核两阶段签署: 执行人登记逐项检查结果(PENDING_REVIEW), 须由另一人审核通过(APPROVED)才形成有效留痕
model PmTask {
  id                  String       @id @default(cuid())
  fstdId              String
  checklistTemplateId String
  level               PmCheckLevel // 冗余存一份, 防止模板后续变更影响历史记录判读
  taskDate            DateTime
  performedById       String? // 执行人 Personnel.id
  responsibleIds      String[] // 责任人(可多人) Personnel.id[]
  itemResultsJson     Json // [{ item: "检查刹车片磨损", passed: true, notes: string }, ...]
  status              PmTaskStatus @default(PENDING_REVIEW)
  reviewedById        String? // 审核人, 须与执行人不同
  reviewedAt          DateTime?
  reviewNotes         String?
  createdAt           DateTime     @default(now())

  fstd     Fstd                @relation(fields: [fstdId], references: [id])
  template PmChecklistTemplate @relation(fields: [checklistTemplateId], references: [id])

  @@map("pm_tasks")
}

/// 故障保留分级 (吸收天津飞安实践, 类似真飞机MEL的Category体系): 允许某些缺陷经评估后正式"带病运行",
/// 不再被3.8排班引擎的Training Restriction规则阻断, 但须有理由说明+审批人留痕, 且可设到期日到期后重新评估。
enum RetentionCategory {
  CATEGORY_I // 短期保留, 严重度较高, 须尽快处理
  CATEGORY_II // 中期保留, 中等严重度
  CATEGORY_III // 长期保留(如待下次定期鉴定处理), 严重度最低, 经评估确认不影响训练科目
}

/// 缺陷/故障处理 (吸收FAA 30天规则 + Kiosk交互模式)
model DiscrepancyLog {
  id                      String             @id @default(cuid())
  fstdId                  String
  reportedById            String? // Personnel.id, 也可来自Kiosk匿名报障
  reportedAt              DateTime           @default(now())
  description             String
  isMmi                   Boolean            @default(false) // Missing/Malfunctioning/Inoperative
  severityRating          Int? // Kiosk打分 1-5, 5为最严重 (对标Simorg)
  trainingTimeLostMinutes Int? // Kiosk记录培训损失时间(分钟)
  correctiveAction        String?
  correctedById           String?
  correctedAt             DateTime?
  status                  String             @default("open") // open / corrected
  dueDate                 DateTime? // 默认报告时间+30天 (吸收FAA §60.25规则)
  retentionCategory       RetentionCategory?
  retentionJustification  String? // 保留理由说明
  retentionApprovedById   String? // Personnel.id
  retentionApprovedAt     DateTime?
  retentionExpiresAt      DateTime? // 保留有效期, 到期需重新评估(到期后即使有分级也恢复阻断)

  fstd              Fstd               @relation(fields: [fstdId], references: [id])
  partMovements     PartMovement[]
  faultyPartRecords FaultyPartRecord[]

  @@map("discrepancy_logs")
}

// ============================================================
// 3.4 备件/工具/校准管理 (对标 Simorg Inventory & Tool)
// ============================================================

/// 备件分类 (吸收天津飞安实践, 航空维修最基础的备件分类之一)
/// 备件类型字典配置 (吸收天津飞安实践: 分类应做成机构可自维护的字典表, 而非写死的枚举)。
/// CONSUMABLE/ROTABLE 两项内置类型(isBuiltIn=true)在机构首次访问时自动懒加载种入, 不可删除但可改label;
/// 机构可自行追加自定义类型, SparePart.partCategory 存该表的 code (字符串, 不再是Prisma枚举)。
model PartTypeConfig {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  label          String
  isBuiltIn      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@map("part_type_configs")
}

model SparePart {
  id                       String   @id @default(cuid())
  organizationId           String
  partNumber               String
  name                     String
  compatibleWith           String? // 按配置树关联使用类型, 一期简化为文本描述, 如 "A320 FFS" / "通用"
  partCategory             String   @default("CONSUMABLE") // 引用同机构 PartTypeConfig.code, 内置"CONSUMABLE"/"ROTABLE"外机构可自行扩展
  unit                     String   @default("pcs")
  minQuantity              Int      @default(0)
  currentQuantity          Int      @default(0)
  location                 String? // 存放位置(仓库货架编号), 区别于 PartMovement.usageLocation(安装使用位置)
  requiresInspection       Boolean  @default(false) // 是否要求入库检测/定期检测 (吸收天津飞安实践: 备件检测区别于tool校准计划)
  inspectionIntervalMonths Int? // 定期检测间隔月数, requiresInspection=true时生效
  createdAt                DateTime @default(now())

  organization       Organization           @relation(fields: [organizationId], references: [id])
  movements          PartMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  faultyPartRecords  FaultyPartRecord[]
  scrapRequests      PartScrapRequest[]
  demandRequests     PartDemandRequest[]
  stocktakeItems     StocktakeItem[]
  warehouseStocks    WarehouseStock[]
  loans              PartLoan[]
  inspectionRecords  PartInspectionRecord[]

  @@unique([organizationId, partNumber])
  @@map("spare_parts")
}

/// 多仓库支持 (吸收天津飞安实践): 区分自有/寄售(备件所有权归供应商)/第三方托管(所有权归本机构但存放于第三方)三种类型
enum WarehouseType {
  OWN
  CONSIGNMENT
  THIRD_PARTY_MANAGED
}

model Warehouse {
  id                String        @id @default(cuid())
  organizationId    String
  name              String
  type              WarehouseType @default(OWN)
  externalPartyInfo String? // 寄售/托管场景下的对方(供应商/托管方)信息
  createdAt         DateTime      @default(now())

  organization  Organization     @relation(fields: [organizationId], references: [id])
  stockBalances WarehouseStock[]
  movements     PartMovement[]

  @@unique([organizationId, name])
  @@map("warehouses")
}

/// 备件按仓库拆分的库存余额明细; SparePart.currentQuantity 仍是权威总量(所有仓库汇总), 未指定仓库的出入库不影响此表
model WarehouseStock {
  id          String @id @default(cuid())
  warehouseId String
  sparePartId String
  quantity    Int    @default(0)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  sparePart SparePart @relation(fields: [sparePartId], references: [id])

  @@unique([warehouseId, sparePartId])
  @@map("warehouse_stocks")
}

/// 借用件管理 (吸收天津飞安实践): 对外借出是需跟踪归还的正式库存动作, 独立于普通领用消耗
model PartLoan {
  id               String    @id @default(cuid())
  sparePartId      String
  quantity         Int
  borrowerInfo     String // 借用方信息(人员/单位)
  purposeNote      String?
  loanedAt         DateTime  @default(now())
  dueDate          DateTime?
  returnedAt       DateTime?
  loanMovementId   String?   @unique // 借出时自动生成的OUT movement
  returnMovementId String?   @unique // 归还时自动生成的IN movement

  sparePart      SparePart     @relation(fields: [sparePartId], references: [id])
  loanMovement   PartMovement? @relation("LoanMovement", fields: [loanMovementId], references: [id])
  returnMovement PartMovement? @relation("ReturnMovement", fields: [returnMovementId], references: [id])

  @@map("part_loans")
}

/// 备件本身的入库检测/定期检测记录 (吸收天津飞安实践: 区别于Tool的校准计划, 适航性相关备件需独立检验记录)
model PartInspectionRecord {
  id          String    @id @default(cuid())
  sparePartId String
  inspectedAt DateTime
  result      String    @default("pass")
  inspectorId String?
  nextDueDate DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  sparePart SparePart @relation(fields: [sparePartId], references: [id])

  @@map("part_inspection_records")
}

enum PartMovementType {
  IN
  OUT
  ADJUSTMENT
}

/// 备件出入库记录, currentQuantity 由此累计得出
model PartMovement {
  id                   String           @id @default(cuid())
  sparePartId          String
  type                 PartMovementType
  quantity             Int // ADJUSTMENT 可为负数表示盘亏
  relatedDiscrepancyId String? // 可关联到消耗该备件的缺陷维修记录, 形成"缺陷→领用备件"追溯链 (吸收天津飞安实践)
  warehouseId          String? // 发生本次出入库的仓库(可选); 提供时同步更新该仓库的WarehouseStock明细
  usageLocation        String? // 安装使用位置(如"FFS-01视景系统机柜"), 区别于SparePart.location(存放位置/货架编号)
  note                 String?
  performedAt          DateTime         @default(now())

  sparePart          SparePart       @relation(fields: [sparePartId], references: [id])
  relatedDiscrepancy DiscrepancyLog? @relation(fields: [relatedDiscrepancyId], references: [id])
  warehouse          Warehouse?      @relation(fields: [warehouseId], references: [id])
  loanFor            PartLoan?       @relation("LoanMovement")
  returnFor          PartLoan?       @relation("ReturnMovement")

  @@map("part_movements")
}

model Tool {
  id                        String   @id @default(cuid())
  organizationId            String
  toolCode                  String
  name                      String
  category                  String?
  location                  String?
  calibrationIntervalMonths Int      @default(12)
  createdAt                 DateTime @default(now())

  organization Organization            @relation(fields: [organizationId], references: [id])
  calibrations ToolCalibrationRecord[]

  @@unique([organizationId, toolCode])
  @@map("tools")
}

model ToolCalibrationRecord {
  id           String    @id @default(cuid())
  toolId       String
  calibratedAt DateTime
  result       String    @default("pass") // pass / fail
  nextDueDate  DateTime?
  performedBy  String?
  createdAt    DateTime  @default(now())

  tool Tool @relation(fields: [toolId], references: [id])

  @@map("tool_calibration_records")
}

model Supplier {
  id              String  @id @default(cuid())
  organizationId  String
  name            String
  serviceCategory String?
  contactInfo     String?

  organization      Organization       @relation(fields: [organizationId], references: [id])
  purchaseOrders    PurchaseOrder[]
  faultyPartRecords FaultyPartRecord[]

  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  organizationId String
  supplierId     String
  status         PurchaseOrderStatus @default(DRAFT)
  createdAt      DateTime            @default(now())
  approvedAt     DateTime?
  receivedAt     DateTime?

  organization   Organization        @relation(fields: [organizationId], references: [id])
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  items          PurchaseOrderItem[]
  demandRequests PartDemandRequest[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  sparePartId     String
  quantity        Int
  unitPrice       Float?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  sparePart     SparePart     @relation(fields: [sparePartId], references: [id])

  @@map("purchase_order_items")
}

/// 故障件管理 (吸收天津飞安实践): 从设备上拆下并确认故障的部件, 走送修/退供应商的独立流程,
/// 区别于普通出入库(3.4.1)和借用件——故障件离开设备后的"生命周期追踪"是周转件管理的核心环节。
enum FaultyPartStatus {
  PENDING_DECISION // 已确认故障, 待决定送修/退供应商/报废
  SENT_FOR_REPAIR
  RETURNED_TO_SUPPLIER
  REPAIRED_RETURNED_TO_STOCK // 送修返回后视为合格品重新入库(自动生成IN movement)
  SCRAPPED
}

model FaultyPartRecord {
  id                   String           @id @default(cuid())
  sparePartId          String
  removedFromFstdId    String?
  relatedDiscrepancyId String? // 触发拆卸的缺陷记录, 形成"缺陷→拆卸故障件"追溯链
  quantity             Int              @default(1)
  faultDescription     String
  status               FaultyPartStatus @default(PENDING_DECISION)
  supplierId           String? // 送修/退换对象
  sentAt               DateTime?
  resolvedAt           DateTime?
  resolutionNotes      String?
  createdAt            DateTime         @default(now())

  sparePart          SparePart       @relation(fields: [sparePartId], references: [id])
  removedFromFstd    Fstd?           @relation(fields: [removedFromFstdId], references: [id])
  relatedDiscrepancy DiscrepancyLog? @relation(fields: [relatedDiscrepancyId], references: [id])
  supplier           Supplier?       @relation(fields: [supplierId], references: [id])

  @@map("faulty_part_records")
}

/// 备件报废管理 (吸收天津飞安实践): 报废须走审批流程(原因码+审批人+审批时间), 不是直接把库存数字减到零
enum ScrapRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model PartScrapRequest {
  id             String             @id @default(cuid())
  sparePartId    String
  quantity       Int
  reasonCode     String // DAMAGED / EXPIRED / OBSOLETE / LOST 等, 一期简化为字符串而非配置表
  requestedById  String?
  status         ScrapRequestStatus @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime           @default(now())

  sparePart SparePart @relation(fields: [sparePartId], references: [id])

  @@map("part_scrap_requests")
}

/// 备件需求登记 (吸收天津飞安实践): 正式采购单之前的"需求登记/预测"阶段, 与已发出的PurchaseOrder是两个不同阶段
enum DemandRequestStatus {
  PENDING
  CONVERTED
  CANCELLED
}

model PartDemandRequest {
  id              String              @id @default(cuid())
  organizationId  String
  sparePartId     String? // 系统内已建档的备件
  partNumber      String? // 或尚未建档的新备件, 仅登记编号/名称用途
  name            String?
  quantity        Int
  neededBy        DateTime?
  requestedById   String?
  status          DemandRequestStatus @default(PENDING)
  purchaseOrderId String? // 转为采购单后回填
  notes           String?
  createdAt       DateTime            @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id])
  sparePart     SparePart?     @relation(fields: [sparePartId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@map("part_demand_requests")
}

/// 备件盘点 (吸收天津飞安实践): 周期性实物盘点, 与系统账面库存对账, 识别差异——
/// 开始盘点时快照当前账面库存(systemQuantity), 逐项录入实盘数(countedQuantity), 对账后按差异生成调整movement
enum StocktakeStatus {
  IN_PROGRESS
  RECONCILED
}

model StocktakeSession {
  id             String          @id @default(cuid())
  organizationId String
  title          String?
  status         StocktakeStatus @default(IN_PROGRESS)
  startedAt      DateTime        @default(now())
  reconciledAt   DateTime?
  reconciledById String?

  organization Organization    @relation(fields: [organizationId], references: [id])
  items        StocktakeItem[]

  @@map("stocktake_sessions")
}

model StocktakeItem {
  id                 String  @id @default(cuid())
  stocktakeSessionId String
  sparePartId        String
  systemQuantity     Int // 开始盘点时的账面库存快照
  countedQuantity    Int? // 实物清点结果, null表示尚未清点该项
  notes              String?

  stocktakeSession StocktakeSession @relation(fields: [stocktakeSessionId], references: [id])
  sparePart        SparePart        @relation(fields: [sparePartId], references: [id])

  @@unique([stocktakeSessionId, sparePartId])
  @@map("stocktake_items")
}

// ============================================================
// 3.5 人员资质管理
// ============================================================

model Personnel {
  id        String   @id @default(cuid())
  tenantId  String
  firstName String
  lastName  String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  roleAssignments   PersonnelRoleAssignment[]
  instructorProfile InstructorProfile?
  qualifications    QualificationRecord[]
  user              User?
  rosterMemberships RosterMember[]
  rosterEntries     RosterEntry[]

  @@map("personnel")
}

enum InstructorType {
  FI // Flight Instructor
  TRI // Type Rating Instructor
  SFI // Synthetic Flight Instructor
  THEORETICAL
  EXAMINER
}

model InstructorProfile {
  id             String         @id @default(cuid())
  personnelId    String         @unique
  instructorType InstructorType

  personnel       Personnel                  @relation(fields: [personnelId], references: [id])
  initialTraining InstructorInitialTraining?

  @@map("instructor_profiles")
}

/// CCAR-142第142.61条(c)款: 教员初始聘任前应完成的≥8小时地面训练(7个科目)并通过笔试, 一次性建档(非周期性记录)
model InstructorInitialTraining {
  id                  String    @id @default(cuid())
  instructorProfileId String    @unique
  completedAt         DateTime? // 培训完成日期; 为空视为未完成
  totalHours          Float? // 实际完成的地面训练小时数, 须≥8
  itemsJson           Json      @default("[]") // [{ item, completed }, ...] (142.61(c)(1)-(7) 7个科目)
  writtenExamPassed   Boolean   @default(false)
  writtenExamDate     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  instructorProfile InstructorProfile @relation(fields: [instructorProfileId], references: [id])

  @@map("instructor_initial_trainings")
}

/// 通用证照/资质记录 + 到期提醒 (人员/学员/设备均可复用此模式, 此处聚焦人员)
model QualificationRecord {
  id                String    @id @default(cuid())
  personnelId       String
  qualificationType String // 执照类型/教员证/考试员证等
  certificateNo     String?
  issuingAuthority  String?
  validFrom         DateTime?
  validUntil        DateTime?
  reminderSentAt    DateTime?
  createdAt         DateTime  @default(now())

  personnel Personnel @relation(fields: [personnelId], references: [id])

  @@map("qualification_records")
}

// ============================================================
// 3.6 课程/培训大纲管理 (一期基础版, 不含ZFTT/MPL等特殊课程)
// ============================================================

enum CourseType {
  LAPL
  PPL
  CPL
  MPL
  ATPL
  INSTRUMENT_RATING
  TYPE_RATING
  OTHER
}

model Course {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  courseType     CourseType
  isApproved     Boolean    @default(false)
  approvedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization      Organization                       @relation(fields: [organizationId], references: [id])
  trainingProgramme TrainingProgramme?
  courseApprovals   TrainingCourseApprovalAttachment[]
  enrollments       Enrollment[]
  requirements      CourseRequirement[]

  @@map("courses")
}

/// 课程对训练科目的要求 (旧体系: 课程直接与设备等级/科目挂钩, 需求清单3.3.3/3.6)
/// taskCode 与 FstdQualifiedTask.taskCode 使用同一套科目编号体系, 用于校验某设备是否满足课程全部要求
model CourseRequirement {
  id       String @id @default(cuid())
  courseId String
  taskCode String
  taskName String
  minHours Float?

  course          Course           @relation(fields: [courseId], references: [id])
  trainingRecords TrainingRecord[]

  @@map("course_requirements")
}

/// ORA.ATO.125 训练大纲
model TrainingProgramme {
  id                String  @id @default(cuid())
  courseId          String  @unique
  stagesJson        Json? // 周/阶段分解表 (CPL/MPL/ATPL类需要)
  standardTasksJson Json? // 标准科目清单
  summary           String?

  course Course @relation(fields: [courseId], references: [id])

  @@map("training_programmes")
}

// ============================================================
// 3.7 学员培训记录管理
// ============================================================

model Student {
  id                String    @id @default(cuid())
  organizationId    String
  firstName         String
  lastName          String
  licenceNo         String?
  medicalCertExpiry DateTime? // ORA.ATO.120(c) 强制记录字段, 训练前置条件校验依赖此字段
  createdAt         DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  enrollments  Enrollment[]

  @@map("students")
}

model Enrollment {
  id          String    @id @default(cuid())
  studentId   String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  status      String    @default("active") // active / completed / withdrawn

  student         Student          @relation(fields: [studentId], references: [id])
  course          Course           @relation(fields: [courseId], references: [id])
  trainingRecords TrainingRecord[]

  @@map("enrollments")
}

/// 训练全程 + 结课后3年保存 (ORA.ATO.120)
model TrainingRecord {
  id                  String   @id @default(cuid())
  enrollmentId        String
  courseRequirementId String? // 关联到课程要求的具体训练科目 (3.6 CourseRequirement), 用于生成进度卡; 留空则为不挂钩具体科目的地面训练记录
  sessionDate         DateTime
  subject             String
  progressNotes       String?
  testScore           String?
  assessedById        String? // Personnel.id
  createdAt           DateTime @default(now())

  enrollment        Enrollment         @relation(fields: [enrollmentId], references: [id])
  courseRequirement CourseRequirement? @relation(fields: [courseRequirementId], references: [id])

  @@map("training_records")
}

// ============================================================
// 3.8 排班与预订 (基础版: 资源日历)
// ============================================================

enum BookingResourceType {
  FSTD
  CLASSROOM
  INSTRUCTOR
}

/// 训练计划视图的"客户配置": 机构级维护客户名称与计划块配色。目前只是颜色标签, 与预订按 customerName 文本对应, 不是独立客户实体
model BookingCustomer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String // #RRGGBB
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@map("booking_customers")
}

model Booking {
  id             String              @id @default(cuid())
  organizationId String // 补充: 租户隔离校验需要, 排课资源始终归属某一机构
  resourceType   BookingResourceType
  resourceId     String // Fstd.id / classroom id / Personnel.id, 视 resourceType 而定
  courseId       String?
  studentId      String?
  taskCode       String? // resourceType=FSTD 时可指定具体训练科目, 用于校验该设备是否已鉴定该科目
  startAt        DateTime
  endAt          DateTime
  status         String              @default("confirmed") // confirmed / cancelled
  customerName   String? // 航司/客户名称 (商业排班场景, 如外部航司包机培训); 可选, 与上面校验逻辑无关
  pilotName      String? // 飞行员姓名, 自由文本 (不要求关联 Personnel 档案)
  instructorName String? // 教员姓名, 自由文本 (不要求关联 Personnel 档案)
  examinerName   String? // 检查员/公司评估员姓名, 自由文本 (熟练检查、考试类训练填写)
  trainingType   String? // 训练类型, 自由文本 (如"定期飞行模拟机复训（CRM）"、"熟练检查"); 与taskCode不同, 不参与设备能力校验
  contactPhone   String?
  revenue        Decimal?            @db.Decimal(12, 2) // 该次排班产生的收入, 自由填写 (不做财务对账用途)
  notes          String?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([resourceType, resourceId, startAt])
  @@map("bookings")
}

// ---- 人员班表 (R2): 班次配置、班组、班表 ----

enum ShiftCategory {
  WORK // 工作班次, 计入工时
  BUSINESS_TRIP // 出差
  SICK_LEAVE // 病假
  COMPENSATORY_LEAVE // 倒休
  ANNUAL_LEAVE // 年假
  OTHER // 其他
}

/// 机构级班次: 工作班次有起止时间 (北京时间, endsNextDay 表示次日结束, 如 E晚班 17:00→次日08:30), 非工作班次没有
model ShiftType {
  id                        String        @id @default(cuid())
  organizationId            String
  code                      String // 班次代码, 如 M/E/D, 机构内唯一
  name                      String
  category                  ShiftCategory
  startTime                 String? // "HH:mm", 仅工作班次
  endTime                   String? // "HH:mm", 仅工作班次
  endsNextDay               Boolean       @default(false)
  restMinutes               Int           @default(0) // 休息时长, 计工时时扣除
  color                     String // #RRGGBB
  generatesMaintenanceTasks Boolean       @default(false) // 是否生成维护任务 (出单联动属于 R4b, 这里只记录配置)
  description               String?
  sortOrder                 Int           @default(0)
  isActive                  Boolean       @default(true)
  createdAt                 DateTime      @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id])
  entries          RosterEntry[]
  dutyLogs         DutyLog[]
  checklistRecords ChecklistRecord[]
  handoverTargets  DutyHandover[]

  @@unique([organizationId, code])
  @@map("shift_types")
}

/// 项目组/班组: 机构内给班表人员分组展示与统计
model RosterGroup {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id])
  members      RosterMember[]
  dutyLogs     DutyLog[]

  @@unique([organizationId, name])
  @@map("roster_groups")
}

/// 进入某机构班表的人员 (Personnel 是租户级档案, 不一定都排班)
model RosterMember {
  id             String   @id @default(cuid())
  organizationId String
  personnelId    String
  groupId        String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  personnel    Personnel    @relation(fields: [personnelId], references: [id])
  group        RosterGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([organizationId, personnelId])
  @@map("roster_members")
}

/// 某人某日(北京时间日历日)的班次; 一人一天最多一条
model RosterEntry {
  id             String   @id @default(cuid())
  organizationId String
  personnelId    String
  date           DateTime @db.Date
  shiftTypeId    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  personnel    Personnel    @relation(fields: [personnelId], references: [id])
  shiftType    ShiftType    @relation(fields: [shiftTypeId], references: [id])

  @@unique([organizationId, personnelId, date])
  @@index([organizationId, date])
  @@map("roster_entries")
}

// ---- 值班日志与交接班 (R4a) ----

enum DutyLogStatus {
  DRAFT // 填写中, 可编辑
  SUBMITTED // 已提交, 锁定 (需先撤回才能改); 提交时固化 DR 操作记录快照, 其交接事项才会进入下一班
}

enum DutyEntryKind {
  ROUTINE // 常规任务
  NON_ROUTINE // 非常规任务
}

/// 某机构某日某班次(可选班组)的一份值班日志; 同一 (机构,日期,班次,班组) 只能有一份。
/// groupKey = groupId ?? "" , 仅用于让"未分组"也参与唯一约束 (PostgreSQL 的唯一索引不把 NULL 视为相同)
model DutyLog {
  id             String        @id @default(cuid())
  organizationId String
  date           DateTime      @db.Date // 北京时间日历日
  shiftTypeId    String
  groupId        String?
  groupKey       String        @default("")
  status         DutyLogStatus @default(DRAFT)
  engineerIds    String[] // 值班工程师 Personnel.id, 创建时按班表预填, 可改
  drSnapshotJson Json? // 提交时固化的"本班内故障(DR)操作"
  createdByEmail String?
  submittedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  shiftType    ShiftType      @relation(fields: [shiftTypeId], references: [id])
  group        RosterGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  entries      DutyEntry[]
  handovers    DutyHandover[]

  @@unique([organizationId, date, shiftTypeId, groupKey])
  @@index([organizationId, date])
  @@map("duty_logs")
}

/// 值班内容: 逐条记录, 区分常规/非常规任务, 可挂到某台设备
model DutyEntry {
  id        String        @id @default(cuid())
  logId     String
  kind      DutyEntryKind @default(ROUTINE)
  content   String
  fstdId    String?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  log DutyLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId])
  @@map("duty_entries")
}

/// 交接事项: 由某份日志(logId)交给目标班次(toDate+toShiftTypeId)。目标默认是下一个工作班次, 可指定。
/// 未完成(completedAt 为空)的事项会一直出现在之后每个班次的"来自上一班"栏, 直到被标记完成。
model DutyHandover {
  id               String    @id @default(cuid())
  logId            String
  content          String
  fstdId           String?
  toDate           DateTime  @db.Date
  toShiftTypeId    String
  toStartAt        DateTime // 目标班次开始时刻(UTC), 用于判断"之后的班次"
  completedAt      DateTime?
  completedInLogId String?
  completedByEmail String?
  createdAt        DateTime  @default(now())

  log     DutyLog   @relation(fields: [logId], references: [id], onDelete: Cascade)
  toShift ShiftType @relation(fields: [toShiftTypeId], references: [id])

  @@index([logId])
  @@index([toStartAt])
  @@map("duty_handovers")
}

// ---- 设备级检查单模板与执行记录 (R4b): 航前/航后 ----

enum ChecklistType {
  PRE_FLIGHT // 航前
  POST_FLIGHT // 航后
}

/// 设备级、可配置的检查单模板: 每台设备每种类型一套。items: [{ no: "1.1", text: "...", sopUrl?: "https://..." }]
/// (和 R1-R3 之前硬编码的 CAAC 14 项航前检查/PM 模板并存, 不替换它们)
model ChecklistTemplate {
  id             String        @id @default(cuid())
  organizationId String
  fstdId         String
  type           ChecklistType
  itemsJson      Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  fstd         Fstd         @relation(fields: [fstdId], references: [id], onDelete: Cascade)

  @@unique([fstdId, type])
  @@map("checklist_templates")
}

/// 某台设备某天某个班次完成的一份检查单 (逐项结果是提交时模板的快照, 之后改模板不影响历史)。
/// "今天应做哪些"不落库, 由班表 + 班次"是否生成维护任务" + 停飞日历 + 模板实时推算, 做完才产生记录。
model ChecklistRecord {
  id                     String        @id @default(cuid())
  organizationId         String
  fstdId                 String
  type                   ChecklistType
  date                   DateTime      @db.Date // 北京时间日历日
  shiftTypeId            String
  performedByPersonnelId String?
  performedByEmail       String?
  itemsJson              Json // [{ no, text, passed, notes? }]
  overallResult          String // pass / issues_found
  note                   String?
  createdAt              DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  fstd         Fstd         @relation(fields: [fstdId], references: [id], onDelete: Cascade)
  shiftType    ShiftType    @relation(fields: [shiftTypeId], references: [id])

  @@unique([fstdId, type, date, shiftTypeId])
  @@index([organizationId, date])
  @@map("checklist_records")
}

// ---- 升级校准记录与 QTG 计划配置 (R7) ----

enum UpgradeCategory {
  MODEL_UPGRADE // 模拟机升级
  SUBSYSTEM_UPGRADE // 子系统升级
  INSTRUMENT_CALIBRATION // 仪表校准
  DATABASE_UPDATE // 数据库更新(视景/导航等)
}

/// 设备的升级、改装、校准历史。工具校准不在此表, 沿用 Tool/ToolCalibrationRecord。
/// isModification/caacReportRef 用于跟踪 CCAR-60 第60.45(c)条"改装前向民航局提交改装报告"的办理情况(只记录, 不代替正式报告)。
model FstdUpgradeRecord {
  id                     String          @id @default(cuid())
  fstdId                 String
  category               UpgradeCategory
  performedOn            DateTime        @db.Date // 北京时间日历日
  title                  String
  description            String?
  subsystem              String? // 子系统升级时: 运动/视景/操纵负荷/音响/IOS ...
  versionFrom            String?
  versionTo              String?
  performedByPersonnelId String?
  performedByName        String? // 外部厂商/工程师等自由文本
  result                 String          @default("pass") // pass / fail
  nextDueDate            DateTime?       @db.Date // 仪表校准的下次到期日
  isModification         Boolean         @default(false) // 是否构成设备改装 (CAAC: 需向民航局报告)
  caacReportRef          String? // 改装报告编号/文号
  caacReportedOn         DateTime?       @db.Date
  notes                  String?
  createdByEmail         String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  fstd Fstd @relation(fields: [fstdId], references: [id], onDelete: Cascade)

  @@index([fstdId, performedOn])
  @@map("fstd_upgrade_records")
}

/// QTG 执行计划: 每台设备每个季度一个计划执行时段 (年内每年重复, 格式 MM-DD) 和责任人。
/// 没有配置时按整个日历季度计。实际完成情况仍记在 FstdQtgQuarterlyRun。
model FstdQtgPlan {
  id             String   @id @default(cuid())
  fstdId         String
  quarter        Int // 1-4
  windowStart    String // "MM-DD"
  windowEnd      String // "MM-DD"
  responsibleIds String[] // Personnel.id, 可多人
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fstd Fstd @relation(fields: [fstdId], references: [id], onDelete: Cascade)

  @@unique([fstdId, quarter])
  @@map("fstd_qtg_plans")
}

// ---- 质量管理 (R6): 会议记录、培训管理、其他检查、问卷 ----

/// 日常部门会议 (区别于 SMS 的安全评审委员会会议 SRB)。固定栏目: 上周工作汇报、本周工作任务、故障分析与讨论、部门工作建议与反馈
model QualityMeeting {
  id                  String   @id @default(cuid())
  organizationId      String
  subject             String
  startAt             DateTime
  endAt               DateTime
  method              String   @default("ONSITE") // ONSITE / ONLINE / HYBRID
  department          String?
  location            String?
  hostPersonnelId     String?
  recorderPersonnelId String?
  attendeeIds         String[] // Personnel.id
  topics              String? // 主要议题
  lastWeekReport      String?
  thisWeekTasksJson   Json     @default("[]") // [{ category: "DAILY|MAJOR|QTG|OTHER", content }]
  faultAnalysis       String?
  suggestions         String?
  createdByEmail      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, startAt])
  @@map("quality_meetings")
}

/// 面向维护/运行人员的内部培训 (不是学员训练记录)
model QualityTraining {
  id             String   @id @default(cuid())
  organizationId String
  subject        String
  startAt        DateTime
  endAt          DateTime
  location       String?
  trainerName    String?
  content        String?
  attendeeIds    String[] // Personnel.id
  createdByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, startAt])
  @@map("quality_trainings")
}

/// 其他检查的检查项配置 (机构级, 名称可自行配置)
model InspectionItem {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@map("inspection_items")
}

/// 临时性/专项检查记录; 逐项结果是提交时检查项名称的快照
model OtherInspection {
  id                     String   @id @default(cuid())
  organizationId         String
  inspectedOn            DateTime @db.Date
  title                  String
  performedByPersonnelId String?
  itemsJson              Json // [{ name, passed, notes? }]
  overallResult          String // pass / issues_found
  notes                  String?
  createdByEmail         String?
  createdAt              DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, inspectedOn])
  @@map("other_inspections")
}

enum SurveyStatus {
  DRAFT // 编辑中
  PUBLISHED // 已发布, 本租户登录用户可填写(每人一次)
  CLOSED // 已关闭, 不再接收回答
}

/// 内部问卷: 题目存为 JSON [{ id, type: SINGLE|MULTI|RATING|TEXT, text, required, options? }]。
/// 发布后同租户的登录用户在"我的问卷"里填写, 每人每份一次; anonymous=true 时统计和填写记录不显示姓名(库里仍存 userId 用来防重复提交)。
model Survey {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String?
  anonymous      Boolean      @default(false)
  status         SurveyStatus @default(DRAFT)
  questionsJson  Json         @default("[]")
  publishedAt    DateTime?
  closedAt       DateTime?
  createdByEmail String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  responses    SurveyResponse[]

  @@index([organizationId, status])
  @@map("surveys")
}

model SurveyResponse {
  id          String   @id @default(cuid())
  surveyId    String
  userId      String
  userEmail   String?
  answersJson Json
  submittedAt DateTime @default(now())

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, userId])
  @@map("survey_responses")
}

// ---- 公开分享链接 (二维码): 训练计划 / 人员班表的只读页面 ----

enum ShareType {
  TRAINING_PLAN
  ROSTER
}

/// 机构某类计划的公开只读分享: 持有链接(二维码)的任何人无需登录即可查看最新计划。
/// token 是 256 位随机串, 不可猜测; 重新生成会让旧二维码立即失效, 停用后链接返回 404。
/// 公开页面只返回计划本身需要的字段, 不含收入、联系电话、备注等商业信息。
model PublicShare {
  id             String    @id @default(cuid())
  organizationId String
  type           ShareType
  token          String    @unique
  enabled        Boolean   @default(true)
  createdByEmail String?
  createdAt      DateTime  @default(now())
  rotatedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, type])
  @@map("public_shares")
}
